{
  "version": 6,
  "configurePresets": [{
    "name": "windows", "generator": "Visual Studio 17 2022",
    "architecture": "x64", "binaryDir": "${sourceDir}/build/windows",
    "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Debug;Release" }
  }, {
    "name": "linux", "generator": "Ninja",
    "binaryDir": "${sourceDir}/build/linux",
    "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
    "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
  }, {
    "name": "macos", "generator": "Ninja",
    "binaryDir": "${sourceDir}/build/macos",
    "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
      "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
    }
  }],
  "buildPresets": [
    {"name":"release", "configurePreset":"windows", "configuration":"Release", "jobs":4},
    {"name":"debug", "configurePreset":"windows", "configuration":"Debug", "jobs":4},
    {"name":"linux-release", "configurePreset":"linux", "jobs":2},
    {"name":"macos-release", "configurePreset":"macos", "jobs":2}
  ],
  "testPresets": [
    {"name":"release", "configurePreset":"windows", "configuration":"Release", "output":{"outputOnFailure":true}},
    {"name":"debug", "configurePreset":"windows", "configuration":"Debug", "output":{"outputOnFailure":true}}
  ]
}
