+// Independent closed app-adapter contract. Validate BEFORE registration or
+// MacroParameterElement construction; no live tree/cache writes or ID allocation.
+static const juce::ValueTree& validateDetachedGraphPluginState (const PluginCreationInfo& info)
+{
+    if (info.mode == PluginCreationInfo::Mode::normal)
+        return info.state;
+    if (info.mode != PluginCreationInfo::Mode::detachedGraph)
+        throw std::invalid_argument ("Unknown plugin construction mode");
+    const auto type = info.state[IDs::type].toString();
+    if (! info.state.hasType (IDs::PLUGIN) || info.state.getParent().isValid() ||
+        ! EditItemID::fromID (info.state).isValid() || info.isNewPlugin ||
+        (type != "vibera_fixed_sampler" && type != "vibera_vst3_effect" && type != "vibera_sidechain_send") ||
+        EditItemID::fromVar (info.state[IDs::masterPluginID]).isValid() ||
+        info.state.hasProperty (IDs::parameters) || info.edit.getPluginCache().getPluginFor (info.state) != nullptr)
+        throw std::invalid_argument ("Detached graph adapter needs private state, reserved ID and supported app type");
+    for (const auto child : info.state)
+    {
+        if (child.hasType (IDs::MODIFIERASSIGNMENTS) && child.getNumChildren() == 0 && child.getNumProperties() == 0)
