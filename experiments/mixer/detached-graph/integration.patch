+        if (! child.hasType (IDs::SIDECHAINCONNECTIONS))
+            throw std::invalid_argument ("Detached graph adapter does not support native macros/modifiers/automation");
+        for (const auto wire : child)
+            if (! wire.hasType (IDs::SIDECHAINCONNECTION) || wire.getNumChildren() != 0)
+                throw std::invalid_argument ("Detached graph adapter has invalid sidechain wire state");
+    }
+    return info.state;
+}
