+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Isolated original draft: requires the companion Project20 model. Not live code.
+#pragma once
+#include "Project.h"
+#include "MixerControls.h"
+#include "ClipGroups.h"
+#include <limits>
+#include <set>
+
+namespace vibera
+{
+inline constexpr int maximumMixerNonMaster = 128;
+inline constexpr int maximumMixerActive = maximumMixerNonMaster + 1;
+inline bool mixerOrganisationName(const juce::String &name)
+{
+    return name.isNotEmpty() && name == name.trim() && name.length() <= 64 &&
+           !name.containsAnyOf("\r\n\t");
+}
+inline bool mixerOrganisationColour(std::uint64_t colour)
+{
+    return colour == 0 || (colour >= 0xff000000ULL && colour <= 0xffffffffULL);
+}
+inline juce::Result validateMixerOrganisation(const Project &p)
+{
+    auto fail = [](const char *message) { return juce::Result::fail(message); };
+    if (p.mixer.empty() || p.mixer.size() > maximumMixerActive || p.mixerOrder.size() != p.mixer.size() ||
+        p.mixerOrder.empty() || p.mixerOrder.front() != 0)
+        return fail("Mixer order must contain every active insert with Master first; maximum128 non-Master plus Master");
+    std::set<int> active, ordered, members;
+    std::int64_t largest = 0;
+    for (const auto &insert : p.mixer)
+    {
+        if (insert.index < 0 || !active.insert(insert.index).second)
+            return fail("Invalid or duplicate Mixer identity");
+        largest = std::max(largest, std::int64_t(insert.index));
+    }
+    for (int index : p.mixerOrder)
+        if (!active.contains(index) || !ordered.insert(index).second)
+            return fail("Mixer order must be a permutation of stable active indices");
+    if (p.nextMixerIndex <= largest || p.nextMixerIndex < 1 ||
+        p.nextMixerIndex > std::int64_t(std::numeric_limits<int>::max()) + 1)
+        return fail("Invalid separate Mixer identity allocator");
+    if (p.mixerGroups.size() > maximumMixerNonMaster)
+        return fail("Mixer group limit exceeded");
+    std::set<Id> groupIds;
+    juce::StringArray names;
+    for (const auto &group : p.mixerGroups)
+    {
+        if (group.id < 1 || group.id > 1000000000 || !groupIds.insert(group.id).second ||
+            !mixerOrganisationName(group.name) || names.contains(group.name, true) ||
+            !mixerOrganisationColour(group.colour) || group.members.empty() || group.members.size() > maximumMixerNonMaster)
+            return fail("Invalid Mixer group identity/name/colour/size");
+        names.add(group.name);
+        for (int member : group.members)
+            if (member == 0 || !active.contains(member) || !members.insert(member).second)
+                return fail("Mixer group members must be unique existing non-Master inserts across groups");
+    }
+    return juce::Result::ok();
+}
+inline void appendMixerOrganisationState(juce::ValueTree &root, const Project &p)
+{
+    root.setProperty("nextMixerIndex", juce::int64(p.nextMixerIndex), nullptr);
+    juce::ValueTree order("MIXER_ORDER"), groups("MIXER_GROUPS");
+    for (int index : p.mixerOrder)
+    {
+        juce::ValueTree item("MEMBER");
+        item.setProperty("insert", index, nullptr);
+        order.appendChild(item, nullptr);
+    }
+    for (const auto &group : p.mixerGroups)
+    {
+        juce::ValueTree item("GROUP");
+        item.setProperty("id", juce::int64(group.id), nullptr);
+        item.setProperty("name", group.name, nullptr);
+        item.setProperty("colour", juce::int64(group.colour), nullptr);
+        for (int index : group.members)
+        {
+            juce::ValueTree member("MEMBER");
+            member.setProperty("insert", index, nullptr);
+            item.appendChild(member, nullptr);
+        }
+        groups.appendChild(item, nullptr);
+    }
+    root.appendChild(order, nullptr);
+    root.appendChild(groups, nullptr);
+}
+inline bool exactMixerNumber(const juce::var &value, std::int64_t low, std::int64_t high,
+                             std::int64_t &result)
+{
+    // ValueTree XML stores attributes as strings; permit only canonical integer
+    // text or actual numeric values, never booleans, coercion or fractional IDs.
+    if (value.isBool() || value.isVoid() || value.isUndefined()) return false;
+    if (value.isString())
+    {
+        const auto text = value.toString();
+        if (text.isEmpty() || text.length() > 12 || text != text.trim() ||
+            !text.containsOnly("0123456789") || (text.length() > 1 && text.startsWithChar('0')))
+            return false;
+        result = text.getLargeIntValue();
+    }
+    else if (value.isInt() || value.isInt64() || value.isDouble())
+    {
+        const double number = double(value);
+        if (!std::isfinite(number) || number != std::floor(number) || number < low || number > high)
+            return false;
+        result = std::int64_t(number);
+    }
+    else return false;
+    return result >= low && result <= high;
+}
+inline juce::Result parseMixerOrganisation(const juce::ValueTree &root, int fileVersion, Project &p)
+{
+    int orderCount = 0, groupCount = 0;
+    for (const auto &child : root)
+    {
+        orderCount += child.hasType("MIXER_ORDER");
+        groupCount += child.hasType("MIXER_GROUPS");
+    }
+    if (fileVersion < 20)
+    {
+        if (root.hasProperty("nextMixerIndex") || orderCount || groupCount)
+            return juce::Result::fail("Mixer organisation data requires project version20");
+        // Genuine19 and older: preserve physical topology and existing IDs.
+        p.nextMixerIndex = 1;
+        p.mixerOrder = {0};
+        for (const auto &insert : p.mixer)
+        {
+            p.nextMixerIndex = std::max(p.nextMixerIndex, std::int64_t(insert.index) + 1);
+            if (insert.index != 0) p.mixerOrder.push_back(insert.index);
+        }
+        return validateMixerOrganisation(p);
+    }
+    if (fileVersion != 20 || orderCount != 1 || groupCount != 1 ||
+        !exactMixerNumber(root["nextMixerIndex"], 1,
+                          std::int64_t(std::numeric_limits<int>::max()) + 1, p.nextMixerIndex))
+        return juce::Result::fail("Missing/duplicate/invalid Mixer organisation schema20 data");
+    const auto order = root.getChildWithName("MIXER_ORDER");
+    const auto groups = root.getChildWithName("MIXER_GROUPS");
+    if (order.getNumChildren() > maximumMixerActive || groups.getNumChildren() > maximumMixerNonMaster)
+        return juce::Result::fail("Mixer organisation encoding exceeds limits");
+    auto member = [](const juce::ValueTree &item, int &index)
+    {
+        std::int64_t value = 0;
+        if (!item.hasType("MEMBER") || item.getNumChildren() != 0 ||
+            !exactMixerNumber(item["insert"], 0, std::numeric_limits<int>::max(), value)) return false;
+        index = int(value);
+        return true;
+    };
+    for (const auto &item : order)
+    {
+        int index = 0;
+        if (!member(item, index)) return juce::Result::fail("Invalid Mixer order member");
+        p.mixerOrder.push_back(index);
+    }
+    for (const auto &item : groups)
+    {
+        std::int64_t id = 0, colour = 0;
+        if (!item.hasType("GROUP") || !item["name"].isString() ||
+            !exactMixerNumber(item["id"], 1, 1000000000, id) ||
+            !exactMixerNumber(item["colour"], 0, 0xffffffffULL, colour) ||
+            item.getNumChildren() < 1 || item.getNumChildren() > maximumMixerNonMaster)
+            return juce::Result::fail("Invalid Mixer group encoding");
+        MixerGroup group{id, item["name"].toString(), juce::uint32(colour), {}};
+        for (const auto &child : item)
+        {
+            int index = 0;
+            if (!member(child, index)) return juce::Result::fail("Invalid Mixer group member encoding");
+            group.members.push_back(index);
+        }
+        p.mixerGroups.push_back(std::move(group));
+    }
+    return validateMixerOrganisation(p);
+}
+
+struct MixerOrganisationArgs
+{
+    std::vector<int> inserts;
+    int beforeInsert = -1; // -1 append, otherwise existing non-Master view target.
+    Id group = 0;
+    juce::String name;
+    double colour = 0;
+    bool rerouteChannelsToMaster = false; // Explicit opt-in when deleting assigned inserts.
+    bool valid = true;
+};
+inline MixerOrganisationArgs mixerOrganisationArgs(const juce::String &command,
+    const std::vector<Id> &ids, Id target, const juce::String &name, double colour,
+    bool rerouteToMaster = false)
+{
+    MixerOrganisationArgs result;
+    result.name = name;
+    result.colour = colour;
+    result.rerouteChannelsToMaster = rerouteToMaster;
+    for (Id id : ids)
+    {
+        if (id < 0 || id > std::numeric_limits<int>::max()) result.valid = false;
+        else result.inserts.push_back(int(id));
+    }
+    if (command.startsWith("mixer.group.")) result.group = target;
+    else if (target == 0) result.beforeInsert = -1;
+    else if (target < 1 || target > std::numeric_limits<int>::max()) result.valid = false;
+    else result.beforeInsert = int(target);
+    return result;
+}
+struct MixerOrganisationResult
+{
+    juce::String code, message;
+    int createdInsert = -1;
+    Id createdGroup = 0;
+    bool completed() const noexcept { return code.isEmpty(); }
+};
+inline MixerOrganisationResult applyMixerOrganisation(Project &project, const juce::String &command,
+                                                        const MixerOrganisationArgs &args)
+{
+    auto fail = [](const char *code, const juce::String &message)
+    { return MixerOrganisationResult{code, message}; };
+    if (!args.valid) return fail("invalid_arguments", "Mixer index must be an exact supported integer");
+    if (auto valid = project.validate(); valid.failed()) return fail("invalid_project", valid.getErrorMessage());
+    Project next = project; // Control thread only; validation failure is atomic.
+    MixerOrganisationResult result;
+    std::set<int> selected;
+    for (int index : args.inserts)
+        if (index == 0 || !mixerInsert(next, index) || !selected.insert(index).second)
+            return fail("unavailable_target", "Select unique existing non-Master inserts");
+    auto namedGroup = [&]() -> MixerGroup *
+    {
+        for (auto &group : next.mixerGroups) if (group.id == args.group) return &group;
+        return nullptr;
+    };
+    auto hasPlugins = [&]
+    {
+        for (const auto &channel : next.channels) if (channel.instrument) return true;
+        for (const auto &insert : next.mixer) if (!insert.effects.empty()) return true;
+        return false;
+    };
+    if (command == "mixer.create")
+    {
+        if (!selected.empty()) return fail("invalid_arguments", "Creation does not accept existing insert IDs");
+        if (next.mixer.size() >= maximumMixerActive || next.nextMixerIndex > std::numeric_limits<int>::max())
+            return fail("limit_exceeded", "Mixer capacity or stable index allocator exhausted");
+        const auto name = args.name.trim();
+        if (name.isNotEmpty() && !mixerOrganisationName(name)) return fail("invalid_arguments", "Invalid Mixer name");
+        auto before = args.beforeInsert == -1 ? next.mixerOrder.end()
+                                             : std::find(next.mixerOrder.begin(), next.mixerOrder.end(), args.beforeInsert);
+        if (args.beforeInsert == 0 || (args.beforeInsert != -1 && before == next.mixerOrder.end()))
+            return fail("unavailable_target", "Insert before an existing non-Master or append");
+        if (hasPlugins()) return fail("requiresPreparedProjection", "Structural change requires prepared transaction; current live/native states retained");
+        result.createdInsert = int(next.nextMixerIndex++);
+        next.mixer.push_back({result.createdInsert, name.isEmpty() ? "Insert " + juce::String(result.createdInsert) : name, 1.f});
+        next.mixerOrder.insert(before, result.createdInsert);
+    }
+    else if (command == "mixer.reorder")
+    {
+        if (selected.empty()) return fail("invalid_arguments", "Choose inserts to reorder");
+        if (args.beforeInsert == 0 || selected.contains(args.beforeInsert) ||
+            (args.beforeInsert != -1 && !mixerInsert(next, args.beforeInsert)))
+            return fail("invalid_arguments", "Reorder target is append or an unselected non-Master insert");
+        std::vector<int> moving;
+        for (int index : next.mixerOrder) if (selected.contains(index)) moving.push_back(index);
+        std::erase_if(next.mixerOrder, [&](int index) { return selected.contains(index); });
+        auto before = args.beforeInsert == -1 ? next.mixerOrder.end()
+                                             : std::find(next.mixerOrder.begin(), next.mixerOrder.end(), args.beforeInsert);
+        next.mixerOrder.insert(before, moving.begin(), moving.end());
+    }
+    else if (command == "mixer.delete")
+    {
+        if (selected.empty()) return fail("invalid_arguments", "Choose inserts to delete");
+        for (const auto &channel : next.channels)
+            if (selected.contains(channel.mixer) && !args.rerouteChannelsToMaster)
+                return fail("reroute_required", "Explicitly reroute assigned Channels to Master before deleting these inserts");
+        if (hasPlugins()) return fail("requiresPreparedProjection", "Capture native states and prepare complete replacement before committing plugin-bearing structural edits");
+        // Restore the original mask if its solo owner is removed; otherwise
+        // preserve the solo owner and recompute its graph mask after pruning.
+        if (next.mixerSolo)
+        {
+            std::erase_if(next.mixerSolo->mutedBefore, [&](int index) { return selected.contains(index); });
+            if (selected.contains(next.mixerSolo->insert))
+            {
+                for (auto &insert : next.mixer)
+                    insert.muted = std::find(next.mixerSolo->mutedBefore.begin(), next.mixerSolo->mutedBefore.end(), insert.index) != next.mixerSolo->mutedBefore.end();
+                next.mixerSolo.reset();
+            }
+        }
+        for (auto &channel : next.channels) if (selected.contains(channel.mixer)) channel.mixer = 0;
+        for (auto &insert : next.mixer)
+            std::erase_if(insert.routes, [&](const auto &route) { return selected.contains(route.target); });
+        std::erase_if(next.mixer, [&](const auto &insert) { return selected.contains(insert.index); });
+        std::erase_if(next.mixerOrder, [&](int index) { return selected.contains(index); });
+        for (auto &group : next.mixerGroups)
+            std::erase_if(group.members, [&](int index) { return selected.contains(index); });
+        std::erase_if(next.mixerGroups, [](const auto &group) { return group.members.empty(); });
+        auto deletedKey = [&](AutomationKey key)
+        { return (key.kind == AutomationParameter::mixerGain || key.kind == AutomationParameter::mixerPan) && selected.contains(int(key.owner)); };
+        for (auto &source : next.automation.sources)
+            std::erase_if(source.links, [&](const auto &link) { return deletedKey(link.key); });
+        std::set<Id> removedSources;
+        for (const auto &source : next.automation.sources) if (source.links.empty()) removedSources.insert(source.id);
+        std::erase_if(next.automation.sources, [&](const auto &source) { return removedSources.contains(source.id); });
+        std::erase_if(next.automation.placements, [&](const auto &placement) { return removedSources.contains(placement.source); });
+        std::erase_if(next.automation.initialValues, [&](const auto &value) { return deletedKey(value.key); });
+        pruneClipGroups(next);
+    }
+    else if (command == "mixer.group.create" || command == "mixer.group.members")
+    {
+        if (selected.empty()) return fail("invalid_arguments", "Mixer group needs at least one member");
+        Id owner = args.group;
+        if (command == "mixer.group.create")
+        {
+            if (args.group != 0 || next.mixerGroups.size() >= maximumMixerNonMaster || next.nextId > 1000000000)
+                return fail("limit_exceeded", "Mixer group capacity/identity exhausted or create has existing target");
+            if (!mixerOrganisationName(args.name.trim())) return fail("invalid_arguments", "Invalid Mixer group name");
+            owner = next.allocate();
+            result.createdGroup = owner;
+            next.mixerGroups.push_back({owner, args.name.trim(), 0, {}});
+        }
+        else if (!namedGroup()) return fail("unavailable_target", "Mixer group is unavailable");
+        for (auto &group : next.mixerGroups)
+        {
+            if (group.id == owner)
+            {
+                group.members.clear();
+                for (int index : next.mixerOrder) if (selected.contains(index)) group.members.push_back(index);
+            }
+            else std::erase_if(group.members, [&](int index) { return selected.contains(index); });
+        }
+        std::erase_if(next.mixerGroups, [](const auto &group) { return group.members.empty(); });
+    }
+    else if (command == "mixer.group.rename" || command == "mixer.group.colour" || command == "mixer.group.remove")
+    {
+        auto *group = namedGroup();
+        if (!group) return fail("unavailable_target", "Mixer group is unavailable");
+        if (!selected.empty()) return fail("invalid_arguments", "This group operation does not accept member IDs");
+        if (command == "mixer.group.rename") group->name = args.name.trim();
+        else if (command == "mixer.group.colour")
+        {
+            if (!std::isfinite(args.colour) || args.colour != std::floor(args.colour) || args.colour < 0 ||
+                args.colour > 0xffffffffULL || !mixerOrganisationColour(std::uint64_t(args.colour)))
+                return fail("invalid_arguments", "Group colour must be0 or opaque ARGB");
+            group->colour = juce::uint32(args.colour);
+        }
+        else std::erase_if(next.mixerGroups, [&](const auto &entry) { return entry.id == args.group; });
+    }
+    else return fail("unsupported_operation", "Unknown Mixer organisation command");
+    reconcileMixerSolo(next);
+    if (auto valid = next.validate(); valid.failed()) return fail("invalid_arguments", valid.getErrorMessage());
+    project = std::move(next);
+    return result;
+}
+
+// Runtime workspace selection. UI and MCP call this same control-thread service;
+// selection is not persisted or inserted into musical Undo.
+struct MixerSelection
+{
+    std::vector<int> inserts{0};
+    int focus = 0, anchor = 0;
+    void reconcile(const Project &p)
+    {
+        std::erase_if(inserts, [&](int index) { return !mixerInsert(p, index); });
+        if (!mixerInsert(p, focus)) focus = inserts.empty() ? 0 : inserts.front();
+        if (inserts.empty()) inserts.push_back(focus);
+        if (!mixerInsert(p, anchor)) anchor = focus;
+    }
+    juce::Result apply(const Project &p, const juce::String &action, const std::vector<int> &targets,
+                       bool expandGroups = false)
+    {
+        if (auto valid = p.validate(); valid.failed()) return valid;
+        MixerSelection next = *this;
+        next.reconcile(p);
+        std::set<int> chosen;
+        for (int index : targets)
+            if (!mixerInsert(p, index) || !chosen.insert(index).second)
+                return juce::Result::fail("Select unique existing Mixer indices");
+        if (action == "range")
+        {
+            if (targets.size() != 1) return juce::Result::fail("Range selection requires one destination");
+            const auto from = std::find(p.mixerOrder.begin(), p.mixerOrder.end(), next.anchor);
+            const auto to = std::find(p.mixerOrder.begin(), p.mixerOrder.end(), targets.front());
+            chosen.clear();
+            for (auto i = std::min(from, to); i != std::max(from, to) + 1; ++i) chosen.insert(*i);
+        }
+        if (expandGroups)
+            for (const auto &group : p.mixerGroups)
+                if (std::any_of(group.members.begin(), group.members.end(), [&](int index) { return chosen.contains(index); }))
+                    chosen.insert(group.members.begin(), group.members.end());
+        std::set<int> result(next.inserts.begin(), next.inserts.end());
+        if (action == "replace" || action == "range") result = chosen;
+        else if (action == "add") result.insert(chosen.begin(), chosen.end());
+        else if (action == "toggle")
+            for (int index : chosen) { if (result.contains(index)) result.erase(index); else result.insert(index); }
+        else return juce::Result::fail("Unsupported Mixer selection action");
+        if (result.empty()) return juce::Result::fail("Mixer selection must retain one focused insert");
+        next.inserts.clear();
+        for (int index : p.mixerOrder) if (result.contains(index)) next.inserts.push_back(index);
+        if (!targets.empty() && result.contains(targets.back())) next.focus = targets.back();
+        else if (!result.contains(next.focus)) next.focus = next.inserts.front();
+        if (action != "range") next.anchor = next.focus;
+        *this = std::move(next);
+        return juce::Result::ok();
+    }
+};
