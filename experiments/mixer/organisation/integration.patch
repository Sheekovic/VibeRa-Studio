+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Unregistered isolated semantic draft. Root integration must register/qualify it.
+#pragma once
+#include "MixerOrganisation.h"
+
+namespace vibera
+{
+inline juce::var mixerOrganisationArgumentSchema(const juce::String &command)
+{
+    auto schema = juce::JSON::parse(R"({"type":"object","additionalProperties":false,"properties":{}})");
+    auto *fields = schema["properties"].getDynamicObject();
+    juce::Array<juce::var> required;
+    const bool members = command == "mixer.delete" || command == "mixer.reorder" ||
+                         command == "mixer.group.create" || command == "mixer.group.members";
+    if (members)
+    {
+        fields->setProperty("ids", juce::JSON::parse(R"({"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":2147483647},"description":"Stable existing non-Master Mixer indices, never view ordinals or global project IDs."})"));
+        fields->getProperty("ids").getDynamicObject()->setProperty("maxItems", maximumMixerNonMaster);
+        required.add("ids");
+    }
+    if (command == "mixer.create" || command == "mixer.reorder")
+        fields->setProperty("target", juce::JSON::parse(R"({"type":"integer","minimum":0,"maximum":2147483647,"default":0,"description":"Existing unselected non-Master insert to place before;0 means append, never before Master. View order only for reorder; physical DSP order is unchanged."})"));
+    else if (command.startsWith("mixer.group.") && command != "mixer.group.create")
+    {
+        fields->setProperty("target", juce::JSON::parse(R"({"type":"integer","minimum":1,"maximum":1000000000,"description":"Stable global Mixer group ID; unrelated to insert indices."})"));
+        required.add("target");
+    }
+    if (command == "mixer.create" || command == "mixer.group.create" || command == "mixer.group.rename")
+    {
+        fields->setProperty("text", juce::JSON::parse(R"({"type":"string","maxLength":64,"description":"Trimmed display name, no CR/LF/tab. Empty create-insert name defaults to Insert plus allocated index. Group name required/nonempty and unique case-insensitively."})"));
+        if (command != "mixer.create") required.add("text");
+    }
+    if (command == "mixer.group.colour")
+    {
+        fields->setProperty("value", juce::JSON::parse(R"({"type":"integer","minimum":0,"maximum":4294967295,"description":"0 follows theme; otherwise opaque ARGB0xff000000..0xffffffff. Partial alpha rejected by canonical validation."})"));
+        required.add("value");
+    }
+    if (command == "mixer.delete")
+    {
+        fields->setProperty("rerouteMixerToMaster", juce::JSON::parse(R"({"type":"boolean","description":"Explicit removal policy. True reroutes assigned Channels to Master; false refuses any assigned insert. Incoming routes and targets in automation are pruned; Undo restores exact musical state. Plugin-bearing structure requires native-state capture and prepared projection, never direct bypass of admission."})"));
+        required.add("rerouteMixerToMaster");
+    }
+    schema.getDynamicObject()->setProperty("required", required);
+    return schema;
+}
+inline juce::var mixerOrganisationSelectionSchema()
+{
+    auto schema = juce::JSON::parse(R"({"type":"object","additionalProperties":false,"required":["action","inserts"],"properties":{"action":{"type":"string","enum":["replace","add","toggle","range"]},"inserts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":2147483647},"description":"Stable Mixer indices. Range requires one destination and uses current view order and selection anchor."},"expandGroups":{"type":"boolean","default":false,"description":"Select the union of display-group members. No routing, project, history or audible controls are changed."}}})");
+    schema["properties"]["inserts"].getDynamicObject()->setProperty("maxItems", maximumMixerActive);
+    return schema;
+}
+inline juce::var mixerOrganisationState(const Project &p, const MixerSelection &selection)
+{
+    auto *state = new juce::DynamicObject;
+    juce::Array<juce::var> order, selected, groups;
+    for (int index : p.mixerOrder) order.add(index);
+    for (int index : selection.inserts) selected.add(index);
+    for (const auto &group : p.mixerGroups)
+    {
+        auto *row = new juce::DynamicObject;
+        row->setProperty("id", juce::int64(group.id)); row->setProperty("name", group.name);
+        row->setProperty("colour", juce::int64(group.colour));
+        juce::Array<juce::var> members;
+        for (int index : group.members) members.add(index);
+        row->setProperty("members", members); groups.add(juce::var(row));
+    }
+    state->setProperty("order", order); state->setProperty("groups", groups);
+    state->setProperty("selectedInserts", selected); state->setProperty("focusedInsert", selection.focus);
+    state->setProperty("selectionAnchor", selection.anchor);
+    state->setProperty("nextMixerIndex", juce::int64(p.nextMixerIndex));
+    state->setProperty("activeCount", int(p.mixer.size())); state->setProperty("maximumActive", maximumMixerActive);
+    state->setProperty("maximumNonMaster", maximumMixerNonMaster);
+    state->setProperty("structuralPluginsRequirePreparedProjection", true);
+    return juce::var(state);
+}
+} // namespace vibera
