+SourceBurstSession::Status SourceBurstSession::validateStaged (juce::AudioDeviceManager& manager,
+    EditPlaybackContext* context, double rate, int block, juce::uint64* serial) const noexcept
+{
+    if (impl->managerIdentity != &manager || !context || impl->contextIdentity != context)
+        return Status::invalidConfiguration;
+    if (impl->current.retired) return Status::retired;
+    if (impl->current.failed) return impl->current.status;
+    if (impl->current.status != Status::staged || impl->current.scopeOpen) return Status::alreadyClaimed;
+    juce::AudioDeviceManager::PhysicalCallbackSnapshot now;
+    if (!impl->reader.read (now)) return Status::telemetryUnavailable;
+    if (!now.ownerAlive) return Status::managerReleased;
+    if (now.writerConflict) return Status::writerConflict;
+    if (now.countersExhausted || now.callbackSerial == std::numeric_limits<juce::uint64>::max()) return Status::counterExhausted;
+    if (!now.active) return Status::deviceStopped;
+    if (now.deviceEpoch != impl->config.deviceEpoch || now.configuredFrames != impl->config.deviceFrames || block != impl->config.deviceFrames)
+        return Status::deviceChanged;
+    if (rate != impl->config.sampleRate) return Status::rateChanged;
+    if (now.maximumOuterFrames > impl->config.maximumPhysicalFrames) return Status::physicalBurstExceeded;
+    if (serial) *serial = now.callbackSerial;
+    return Status::staged;
+}
+SourceBurstSession::Status SourceBurstSession::armStaged (juce::AudioDeviceManager& manager,
+    EditPlaybackContext* context, double rate, int block) noexcept
+{
+    juce::uint64 serial = 0;
+    const auto valid = validateStaged (manager, context, rate, block, &serial);
+    if (valid != Status::staged)
+    {
+        impl->fail (valid); // Native late failure, never fabricated completed activation.
+        return valid;
+    }
+    impl->initialActivation = true; // Same strict later-serial/offset0 admission as cold activation.
+    impl->lastClosedSerial = serial;
+    impl->current.activationAfterSerial = serial;
+    impl->current.status = Status::pendingFirstSerial;
+    impl->publish();
+    return Status::pendingFirstSerial;
+}
