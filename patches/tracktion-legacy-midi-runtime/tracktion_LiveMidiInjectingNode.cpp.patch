+// ORIGINAL ordinary-policy owner. Payload semantics and inherited generic
+// lock/allocation behaviour remain unchanged. Only ownership moves from graph
+// shell to exact Track/context Runtime; no queue transfer during preparation.
+struct LiveMidiInjectingNode::LegacyRuntime final : AudioTrack::Listener
+{
+    const AudioTrack::Ptr track;
+    const ProcessState* const scope;
+    juce::CriticalSection lock;
+    MidiMessageArray messages;
+    const MPESourceID source = createUniqueMPESourceID();
+    LegacyRuntime (AudioTrack& owner, const ProcessState* context) : track (&owner), scope (context)
+    { track->addListener (this); }
+    ~LegacyRuntime() override { track->removeListener (this); } // Excluded CONTROL retirement only.
+    void injectLiveMidiMessage (AudioTrack& owner, const MidiMessageWithSource& input, bool& used) override
+    {
+        if (&owner != track.get()) return;
+        auto value = input;
+        value.setTimeStamp (0.0);
+        const juce::ScopedLock hold (lock);
+        messages.add (std::move (value));
+        used = true; // Broadcast remains legitimate for independent contexts.
+    }
+    void recordedMidiMessageSentToPlugins (AudioTrack&, const juce::MidiMessage&) override {}
+};
