+EditPlaybackContext::GraphSelection EditPlaybackContext::getGraphSelection() const noexcept
+{
+    // Same allocated-context lifetime requirement as existing EPC input APIs;
+    // this does not make nodePlaybackContext destruction concurrently safe.
+    return nodePlaybackContext ? nodePlaybackContext->player.graphSelection() : GraphSelection{};
+}
+
+bool EditPlaybackContext::tryGetSelectedGraphLatencySamples (int& samples) const noexcept
+{
+    const auto selected = getGraphSelection();
+    if (selected.state != graph::LockFreeMultiThreadedNodePlayer::GraphSelectionState::selected)
+        return false;
+    samples = selected.latencySamples;
+    return true;
+}
