+void LockFreeMultiThreadedNodePlayer::publishSelection (const PreparedNode& holder,
+                                                           juce::Range<int64_t> reference) noexcept
+{
+    const auto sequence = selectionSequence.load (std::memory_order_seq_cst);
+    if (selectionSequenceExhausted.load (std::memory_order_seq_cst)) return;
+    if (sequence >= std::numeric_limits<uint64_t>::max() - 2)
+    {
+        selectionSequenceExhausted.store (true, std::memory_order_seq_cst);
+        return; // Permanent explicit stale; never silently wrap receipt lineage.
+    }
+    selectionSequence.store (sequence + 1, std::memory_order_seq_cst);
+    selectedGraphSerial.store (holder.selectionSerial, std::memory_order_seq_cst);
+    selectedLatencySamples.store (holder.preparedLatencySamples, std::memory_order_seq_cst);
+    selectedReferenceStart.store (reference.getStart(), std::memory_order_seq_cst);
+    selectedReferenceEnd.store (reference.getEnd(), std::memory_order_seq_cst);
+    selectionSequence.store (sequence + 2, std::memory_order_seq_cst);
+}
+
+LockFreeMultiThreadedNodePlayer::GraphSelection LockFreeMultiThreadedNodePlayer::graphSelection() const noexcept
+{
+    GraphSelection result;
+    for (unsigned attempt = 0; attempt < 8; ++attempt)
+    {
+        const auto posted = postedSelectionSerial.load (std::memory_order_seq_cst);
+        const auto minimum = minimumSelectionSerial.load (std::memory_order_seq_cst);
+        if (selectionSequenceExhausted.load (std::memory_order_seq_cst))
+        { result = {}; result.state = GraphSelectionState::stale; return result; }
+        const auto before = selectionSequence.load (std::memory_order_seq_cst);
+        if ((before & 1) != 0) continue;
+        result.selectedSerial = selectedGraphSerial.load (std::memory_order_seq_cst);
+        result.latencySamples = selectedLatencySamples.load (std::memory_order_seq_cst);
+        result.referenceStart = selectedReferenceStart.load (std::memory_order_seq_cst);
+        result.referenceEnd = selectedReferenceEnd.load (std::memory_order_seq_cst);
+        const auto after = selectionSequence.load (std::memory_order_seq_cst);
+        if (before != after || (after & 1) != 0 || (posted != 0 && result.selectedSerial > posted) ||
+            posted != postedSelectionSerial.load (std::memory_order_seq_cst) ||
+            minimum != minimumSelectionSerial.load (std::memory_order_seq_cst)) continue;
+        result.postedSerial = posted;
+        if (posted == 0) { result = {}; return result; }
+        if (result.selectedSerial < minimum || result.selectedSerial == 0)
+        {
+            result = {}; result.state = GraphSelectionState::awaitingFirstSelection;
+            result.postedSerial = posted; return result;
+        }
+        result.state = GraphSelectionState::selected;
+        return result; // selectedSerial may intentionally differ from postedSerial.
+    }
+    result = {}; result.state = GraphSelectionState::stale;
+    return result; // Bounded refusal, never spin/wait for a callback writer.
+}
