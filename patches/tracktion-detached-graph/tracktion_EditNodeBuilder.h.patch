+// ORIGINAL opt-in immutable routing specification. CONTROL preparation/build
+// only, never queried by DSP. It does not mutate TrackOutput or own an Edit.
+class GraphOutputRouting final
+{
+public:
+    enum class Target { defaultWaveDevice, destinationTrack, disconnected };
+    struct Route
+    {
+        EditItemID source;
+        Target target = Target::defaultWaveDevice;
+        EditItemID destination; // Valid ONLY for destinationTrack; native stable ID, not list index.
+    };
+    enum class Status
+    {
+        foreignEdit, changedUniverse, unsupportedTrack, unsupportedNativeOutput,
+        invalidSource, duplicateSource, incompleteMap, invalidDestination,
+        invalidTarget, cycle, changedNativeOutput, changedDefaultDevice
+    };
+    class Error final : public std::invalid_argument
+    {
+    public:
+        Error (Status value, const char* message) : std::invalid_argument (message), status (value) {}
+        const Status status;
+    };
+    struct Resolved
+    {
+        Target target;
+        AudioTrack* destination = nullptr;
+        OutputDevice* device = nullptr;
+    };
+    // Complete map for EVERY existing AudioTrack, exact fixed track universe.
+    // A named/MIDI-device route or submix/freeze needs a future explicit contract.
+    static std::shared_ptr<const GraphOutputRouting> prepare (Edit&, std::vector<Route>);
+    ~GraphOutputRouting(); // CONTROL only; no last-owner retirement on callback.
+    GraphOutputRouting (const GraphOutputRouting&) = delete;
+    GraphOutputRouting& operator= (const GraphOutputRouting&) = delete;
+    void validateForBuild (Edit&, bool needsLiveDevice) const; // May allocate/throw before native Nodes.
+    Resolved resolve (const Track&) const;                    // Only within validated sole-control build lease.
+    const std::vector<Route>& getRoutes() const noexcept;
+private:
+    struct Impl;
+    explicit GraphOutputRouting (std::unique_ptr<Impl>);
+    std::unique_ptr<Impl> impl;
+};
