+bool Plugin::retainFixedInitialisation (double fixedRate, int fixedBlock) noexcept
+{
+    static_assert (std::atomic<int>::is_always_lock_free);
+    // The fixed configuration fields have no control writer under the caller's
+    // lease; DSP only reads them. Equal-value stores would still be a data race.
+    if (! std::isfinite (fixedRate) || fixedRate <= 0.0 || fixedBlock <= 0 ||
+        fixedRate != sampleRate || fixedBlock != blockSizeSamples)
+        return false;
+    auto count = initialiseCount.load (std::memory_order_acquire);
+    if (count <= 0 || count == std::numeric_limits<int>::max()) return false;
+    return initialiseCount.compare_exchange_strong (count, count + 1,
+               std::memory_order_acq_rel, std::memory_order_acquire);
+}
+
+void Plugin::attachFixedGraphInitialisation (const PluginInitialisationInfo& info)
+{
+    if (! std::isfinite (info.sampleRate) || info.sampleRate <= 0.0 || info.blockSizeSamples <= 0)
+        throw std::invalid_argument ("Fixed graph initialization requires valid rate/block");
+    const auto initialCount = initialiseCount.load (std::memory_order_acquire);
+    if (initialCount != 0)
+    {
+        if (! retainFixedInitialisation (info.sampleRate, info.blockSizeSamples))
+            throw std::invalid_argument ("Fixed graph owner/configuration/count admission refused");
+        return;
+    }
+    if (! isDetachedGraph())
+        throw std::invalid_argument ("Fixed graph first initialization requires a private detached shell");
+    try
+    {
+        baseClassInitialise (info); // Ordinary lifecycle, only this private shell.
+    }
+    catch (...)
+    {
+        // No complete Node exists yet. baseClassInitialise increments BEFORE
+        // virtual initialise/reset/iterator calls. The closed control lease
+        // excludes another count owner or config writer during this call.
+        isInitialisingFlag = false;
+        const auto ownedCount = initialiseCount.load (std::memory_order_acquire);
+        if (ownedCount == 1) baseClassDeinitialise();
+        else if (ownedCount != 0)
+            throw std::logic_error ("Fixed graph private initialization violated count ownership");
+        throw;
+    }
+}
