+static void requireFixedGraphPluginAdmission (const Plugin& plugin, const CreateNodeParams& params)
+{
+    if (params.fixedInitialisationAdmission && ! params.fixedInitialisationAdmission (plugin))
+        throw std::invalid_argument ("Private graph encountered an unadmitted plugin owner/type");
+}
+static bool useFixedGraphInitialisation (const Plugin& plugin, const CreateNodeParams& params)
+{
+    if (! params.fixedInitialisationAdmission) return false;
+    requireFixedGraphPluginAdmission (plugin, params);
+    if (! plugin.baseClassNeedsInitialising()) return true;
+    if (! plugin.isDetachedGraph())
+        throw std::invalid_argument ("Private graph cannot first-initialise a live native plugin");
+    return true; // Fixed path owns first-private exception safety as well.
+}
