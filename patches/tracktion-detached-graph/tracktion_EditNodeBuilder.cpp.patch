+// ORIGINAL routing owner. Native routing remains untouched when no map is supplied.
+struct GraphOutputRouting::Impl
+{
+    struct NativeOutput
+    {
+        Target target;
+        SafeSelectable<AudioTrack> destination;
+    };
+    struct Entry
+    {
+        SafeSelectable<AudioTrack> source;
+        EditItemID id;
+        SafeSelectable<AudioTrack> destination;
+        NativeOutput native;
+        Target target;
+    };
+    SafeSelectable<Edit> owner;
+    std::vector<SafeSelectable<Track>> universe;
+    std::vector<EditItemID> universeIDs;
+    std::vector<Entry> entries;
+    std::vector<Route> routes;
+    std::map<EditItemID, size_t> byID;
+    SafeSelectable<WaveOutputDevice> defaultDevice;
+    juce::String defaultDeviceID;
+    ChannelConfiguration defaultChannels;
+
+    static NativeOutput captureNative (AudioTrack& track)
+    {
+        if (track.isPartOfSubmix() || track.isFrozen (Track::anyFreeze))
+            throw Error (Status::unsupportedTrack, "outputRouting.unsupportedTrack: Submix/frozen audio routing is not admitted");
+        auto& output = track.getOutput();
+        if (auto destination = output.getDestinationTrack())
+            return { Target::destinationTrack, destination };
+        if (output.usesDefaultAudioOut())
+            return { Target::defaultWaveDevice, {} };
+        if (output.outputsToNone())
+            return { Target::disconnected, {} };
+        throw Error (Status::unsupportedNativeOutput,
+                     "outputRouting.unsupportedNativeOutput: Named/MIDI/unresolved native device routing requires an explicit contract");
+    }
+};
+GraphOutputRouting::GraphOutputRouting (std::unique_ptr<Impl> value) : impl (std::move (value)) {}
+GraphOutputRouting::~GraphOutputRouting() = default;
+const std::vector<GraphOutputRouting::Route>& GraphOutputRouting::getRoutes() const noexcept { return impl->routes; }
+
+std::shared_ptr<const GraphOutputRouting> GraphOutputRouting::prepare (Edit& edit, std::vector<Route> routes)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    auto next = std::make_unique<Impl>();
+    next->owner = &edit;
+    // Fix identities/order as well as IDs. Native weak references reject destroyed
+    // owners even if an allocator later reuses the same address (no pointer ABA).
+    std::set<EditItemID> allIDs;
+    for (auto* track : getAllTracks (edit))
+    {
+        if (! track->itemID.isValid() || ! allIDs.insert (track->itemID).second)
+            throw Error (Status::invalidSource, "outputRouting.invalidSource: Track universe contains invalid/duplicate native IDs");
+        next->universe.emplace_back (track);
+        next->universeIDs.push_back (track->itemID);
+        if (auto* folder = dynamic_cast<FolderTrack*> (track))
+            if (folder->isSubmixFolder() || folder->getOutput() != nullptr)
+                throw Error (Status::unsupportedTrack, "outputRouting.unsupportedTrack: Submix-folder routing is not admitted");
+        if (auto* audio = dynamic_cast<AudioTrack*> (track))
+        {
+            const auto index = next->entries.size();
+            next->byID.emplace (audio->itemID, index);
+            next->entries.push_back ({ audio, audio->itemID, {}, Impl::captureNative (*audio), Target::defaultWaveDevice });
+        }
+    }
+    // Hardware InsertPlugin output roots are a different routing namespace;
+    // don't silently represent them as TrackOutput decisions in this opt-in.
+    for (auto* plugin : edit.getPluginCache().getPlugins())
+        if (dynamic_cast<InsertPlugin*> (plugin) && plugin->state.getParent().isValid() && plugin->state.getRoot() == edit.state)
+            throw Error (Status::unsupportedNativeOutput, "outputRouting.unsupportedNativeOutput: Hardware insert device roots are not admitted");
+
+    std::set<EditItemID> supplied;
+    for (const auto& route : routes)
+    {
+        const auto found = next->byID.find (route.source);
+        if (! route.source.isValid() || found == next->byID.end())
+            throw Error (Status::invalidSource, "outputRouting.invalidSource: Source must identify an existing same-Edit AudioTrack");
+        if (! supplied.insert (route.source).second)
+            throw Error (Status::duplicateSource, "outputRouting.duplicateSource: One explicit route per AudioTrack is required");
+        auto& entry = next->entries[found->second];
+        entry.target = route.target;
+        switch (route.target)
+        {
+            case Target::defaultWaveDevice:
+            case Target::disconnected:
+                if (route.destination.isValid())
+                    throw Error (Status::invalidDestination, "outputRouting.invalidDestination: This target must not carry a destination ID");
+                break;
+            case Target::destinationTrack:
+            {
+                const auto destination = next->byID.find (route.destination);
+                if (! route.destination.isValid() || destination == next->byID.end() || destination == found)
+                    throw Error (Status::invalidDestination, "outputRouting.invalidDestination: Target must be a distinct existing same-Edit AudioTrack");
+                entry.destination = next->entries[destination->second].source;
+                break;
+            }
+            default:
+                throw Error (Status::invalidTarget, "outputRouting.invalidTarget: Unknown routing target discriminant");
+        }
+    }
+    if (supplied.size() != next->entries.size())
+        throw Error (Status::incompleteMap, "outputRouting.incompleteMap: Every existing AudioTrack needs an explicit entry");
+    // Outdegree<=1: iterative bounded colouring, no recursive graph construction
+    // until all main-output dependencies are proven acyclic.
+    std::vector<unsigned char> colour (next->entries.size(), 0);
+    std::vector<size_t> path;
+    path.reserve (next->entries.size());
+    for (size_t start = 0; start < next->entries.size(); ++start)
+    {
+        path.clear();
+        auto current = start;
+        for (;;)
+        {
+            if (colour[current] == 2) break;
+            if (colour[current] == 1)
+                throw Error (Status::cycle, "outputRouting.cycle: Main-output destinations form a cycle");
+            colour[current] = 1;
+            path.push_back (current);
+            const auto& entry = next->entries[current];
+            if (entry.target != Target::destinationTrack) break;
+            current = next->byID.at (entry.destination->itemID);
+        }
+        for (auto index : path) colour[index] = 2;
+    }
+    next->routes = std::move (routes);
+    auto* device = edit.engine.getDeviceManager().getDefaultWaveOutDevice();
+    next->defaultDevice = device;
+    if (device != nullptr)
+    {
+        next->defaultDeviceID = device->getDeviceID();
+        next->defaultChannels = device->getChannels();
+    }
+    return std::shared_ptr<const GraphOutputRouting> (new GraphOutputRouting (std::move (next)));
+}
+
+void GraphOutputRouting::validateForBuild (Edit& edit, bool needsLiveDevice) const
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    if (impl->owner.get() != &edit)
+        throw Error (Status::foreignEdit, "outputRouting.foreignEdit: Routing owner does not match this Edit");
+    const auto current = getAllTracks (edit);
+    if (size_t (current.size()) != impl->universe.size())
+        throw Error (Status::changedUniverse, "outputRouting.changedUniverse: Track CRUD/reorder requires a new candidate universe");
+    for (size_t index = 0; index < impl->universe.size(); ++index)
+    {
+        auto* track = current[int (index)];
+        if (track != impl->universe[index].get() || track->itemID != impl->universeIDs[index])
+            throw Error (Status::changedUniverse, "outputRouting.changedUniverse: Existing Track identities/order must remain exact");
+        if (auto* folder = dynamic_cast<FolderTrack*> (track))
+            if (folder->isSubmixFolder() || folder->getOutput() != nullptr)
+                throw Error (Status::unsupportedTrack, "outputRouting.unsupportedTrack: Submix-folder mode changed");
+    }
+    for (const auto& entry : impl->entries)
+    {
+        if (entry.source == nullptr || &entry.source->edit != &edit || entry.source->itemID != entry.id)
+            throw Error (Status::changedUniverse, "outputRouting.changedUniverse: Source Track was removed/replaced");
+        const auto actual = Impl::captureNative (*entry.source.get());
+        if (actual.target != entry.native.target || actual.destination.get() != entry.native.destination.get())
+            throw Error (Status::changedNativeOutput, "outputRouting.changedNativeOutput: Native TrackOutput changed after preparation");
+        if (entry.target == Target::destinationTrack && entry.destination == nullptr)
+            throw Error (Status::invalidDestination, "outputRouting.invalidDestination: Prepared destination no longer exists");
+    }
+    for (auto* plugin : edit.getPluginCache().getPlugins())
+        if (dynamic_cast<InsertPlugin*> (plugin) && plugin->state.getParent().isValid() && plugin->state.getRoot() == edit.state)
+            throw Error (Status::unsupportedNativeOutput, "outputRouting.unsupportedNativeOutput: Hardware insert roots changed");
+    if (needsLiveDevice)
+    {
+        auto* device = edit.engine.getDeviceManager().getDefaultWaveOutDevice();
+        if (device == nullptr || device != impl->defaultDevice.get() || ! device->isEnabled() ||
+            device->getDeviceID() != impl->defaultDeviceID || device->getChannels() != impl->defaultChannels)
+            throw Error (Status::changedDefaultDevice, "outputRouting.changedDefaultDevice: Live default output/configuration is unavailable or changed");
+    }
+}
+
+GraphOutputRouting::Resolved GraphOutputRouting::resolve (const Track& track) const
+{
+    if (impl->owner.get() != &track.edit)
+        throw Error (Status::foreignEdit, "outputRouting.foreignEdit: Track belongs to a different Edit");
+    const auto found = impl->byID.find (track.itemID);
+    if (found == impl->byID.end() || impl->entries[found->second].source.get() != &track)
+        throw Error (Status::invalidSource, "outputRouting.invalidSource: Unknown/replaced source Track");
+    const auto& entry = impl->entries[found->second];
+    auto* destination = entry.destination.get();
+    if (entry.target == Target::destinationTrack && destination == nullptr)
+        throw Error (Status::invalidDestination, "outputRouting.invalidDestination: Destination owner is unavailable");
+    return { entry.target, destination,
+             entry.target == Target::defaultWaveDevice ? impl->defaultDevice.get() : nullptr };
+}
