+bool LiveMidiInjectingNode::hasOnlyBoundedNoopOutputListeners (AudioTrack& track, const ProcessState& scope)
+{
+    auto* messages = juce::MessageManager::getInstanceWithoutCreating();
+    if (!messages || !messages->isThisTheMessageThread())
+        throw std::invalid_argument ("pluginOutput.controlOwner: Message-thread listener inventory required");
+    for (auto* listener : track.getListeners().getListeners())
+    {
+        auto* runtime = dynamic_cast<BoundedRuntime*> (listener);
+        if (!runtime || runtime->track.get() != &track || runtime->scope != &scope || !runtime->registered)
+            return false;
+    }
+    return true;
+}
 
