+    // CONTROL only after graph transforms; no current-sample inspection.
+    static bool isStructurallySilent (Node& root)
+    {
+        std::set<Node*> visiting;
+        std::map<Node*, bool> completed;
+        constexpr size_t maximumNodes = 4096, maximumDepth = 256;
+        const auto visit = [&] (auto&& self, Node& node, size_t depth) -> bool
+        {
+            if (const auto found = completed.find (&node); found != completed.end())
+                return found->second;
+            const auto* declaration = dynamic_cast<const StructuralAudioSilence*> (&node);
+            if (!declaration) return false; // Default unknown: no traversal/allocation.
+            if (depth > maximumDepth || completed.size() + visiting.size() >= maximumNodes ||
+                !visiting.insert (&node).second) return false;
+            const auto finish = [&] (bool zero)
+            { visiting.erase (&node); completed.emplace (&node, zero); return zero; };
+            const auto kind = declaration->structuralAudioSilenceKind();
+            const auto properties = node.getNodeProperties();
+            if (kind == StructuralAudioSilence::Kind::unknown || properties.hasMidi ||
+                !properties.hasAudio || properties.numberOfChannels <= 0 || node.canShareOutputBuffer())
+                return finish (false);
+            const auto inputs = node.getDirectInputNodes();
+            bool zero = kind == StructuralAudioSilence::Kind::zeroLeaf ? inputs.empty() :
+                        kind == StructuralAudioSilence::Kind::zeroPreservingInputs && !inputs.empty();
+            if (kind == StructuralAudioSilence::Kind::zeroPreservingInputs)
+                for (auto* source : inputs) zero = zero && source && self (self, *source, depth + 1);
+            return finish (zero);
+        };
+        return visit (visit, root, 0);
