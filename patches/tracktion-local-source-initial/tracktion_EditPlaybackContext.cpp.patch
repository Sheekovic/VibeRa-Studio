+Edit::NativeCapabilityStatus EditPlaybackContext::tryGlobalStreamTimeToEditTime (double time, bool unlooped, TimePosition& output) const noexcept
+{
+    const auto status = edit.admitNativeCapability (Edit::NativeCapability::globalTimestamp);
+    if (status != Edit::NativeCapabilityStatus::allowed) return status;
+    if (!nodePlaybackContext) return Edit::NativeCapabilityStatus::contextUnavailable;
+    if (!std::isfinite (time)) return Edit::NativeCapabilityStatus::invalidTimestamp;
+    const auto rate = getSampleRate();
+    if (!std::isfinite (rate) || rate <= 0) return Edit::NativeCapabilityStatus::contextUnavailable;
+    const auto position = time * rate;
+    if (!std::isfinite (position) || position <= double (std::numeric_limits<juce::int64>::min()) ||
+        position >= double (std::numeric_limits<juce::int64>::max())) return Edit::NativeCapabilityStatus::invalidTimestamp;
+    const auto sample = tracktion::graph::timeToSample (time, rate);
+    const auto timeline = unlooped
+        ? nodePlaybackContext->playHead.referenceSamplePositionToTimelinePositionUnlooped (sample)
+        : nodePlaybackContext->playHead.referenceSamplePositionToTimelinePosition (sample);
+    output = TimePosition::fromSamples (timeline, rate);
+    return Edit::NativeCapabilityStatus::allowed;
+}
