@@ -136,6 +142,40 @@
 
     /// A reference to the Engine.
     Engine& engine;
+    const juce::uint64 initialSourceGeneration;
+    const bool closedNativeIO; // Immutable construction policy, never read from project ValueTree.
+    enum class SourceReferenceDomain { managerGlobal, localClosed };
+    enum class NativeCapability { inputOutput, contextSync, globalTimestamp, externalClock };
+    enum class NativeCapabilityStatus { allowed, nativeIOForbidden, contextSyncForbidden,
+        globalTimestampForbidden, externalClockForbidden, invalidTimestamp, contextUnavailable };
+    SourceReferenceDomain sourceReferenceDomain() const noexcept
+    { return initialSourceGeneration ? SourceReferenceDomain::localClosed : SourceReferenceDomain::managerGlobal; }
+    NativeCapabilityStatus nativeCapability (NativeCapability capability) const noexcept
+    {
+        if (capability == NativeCapability::inputOutput && closedNativeIO)
+            return NativeCapabilityStatus::nativeIOForbidden;
+        if (!initialSourceGeneration) return NativeCapabilityStatus::allowed;
+        switch (capability)
+        {
+            case NativeCapability::contextSync: return NativeCapabilityStatus::contextSyncForbidden;
+            case NativeCapability::globalTimestamp: return NativeCapabilityStatus::globalTimestampForbidden;
+            case NativeCapability::externalClock: return NativeCapabilityStatus::externalClockForbidden;
+            case NativeCapability::inputOutput: return NativeCapabilityStatus::nativeIOForbidden;
+        }
+        return NativeCapabilityStatus::allowed;
+    }
+    NativeCapabilityStatus admitNativeCapability (NativeCapability capability) const noexcept
+    {
+        const auto status = nativeCapability (capability);
+        if (status != NativeCapabilityStatus::allowed)
+            nativeCapabilityRefusal.store (status, std::memory_order_release);
+        return status;
+    }
+    NativeCapabilityStatus lastNativeCapabilityRefusal() const noexcept
+    { return nativeCapabilityRefusal.load (std::memory_order_acquire); }
+    // Diagnostic scalar only; concurrent refused callers never share a payload seqlock.
+    mutable std::atomic<NativeCapabilityStatus> nativeCapabilityRefusal { NativeCapabilityStatus::allowed };
+    static_assert (std::atomic<NativeCapabilityStatus>::is_always_lock_free);
 
