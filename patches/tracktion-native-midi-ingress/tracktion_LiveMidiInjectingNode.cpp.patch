+struct LiveMidiInjectingNode::BoundedRuntime final : AudioTrack::Listener
+{
+    static constexpr uint64_t capacity = 512;
+    struct Event { std::array<uint8_t, 3> bytes{}; uint8_t size = 0; MPESourceID source = {}; };
+    AudioTrack::Ptr track;
