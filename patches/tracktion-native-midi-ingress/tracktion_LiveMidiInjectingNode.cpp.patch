+            const auto* bytes = message.getRawData();
+            if (size < 1 || size > 3 || bytes[0] < 0x80 || bytes[0] == 0xf0 || bytes[0] == 0xf7 ||
+                juce::MidiMessage::getMessageLengthFromFirstByte (bytes[0]) != size)
+            { fail (IngressFault::sourceMessage); return false; }
+        }
