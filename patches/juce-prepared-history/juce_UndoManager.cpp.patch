+bool UndoManager::undoCurrentTransactionOnly()
+{
+    const PreparedMutationScope preparedScope (*this);
+    if ((! newTransaction) && undo())
+    {
+        restoreStashedFutureTransactions();
+        return true;
+    }
+
+    return false;
+}
