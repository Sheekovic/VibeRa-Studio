+    if (auto* s = getCurrentSet())
+        return s->time;
+
+    return {};
+}
+
+Time UndoManager::getTimeOfRedoTransaction() const
+{
+    if (auto* s = getNextSet())
+        return s->time;
+
+    return Time::getCurrentTime();
+}
