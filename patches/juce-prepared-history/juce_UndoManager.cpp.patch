+//==============================================================================
+struct UndoManager::PreparedHistoryMutation::Impl
+{
+    enum class Kind { newTransaction, undo, redo };
+    UndoManager* owner = nullptr;
+    std::uint64_t generation = 0;
+    Kind kind = Kind::newTransaction;
+    ActionSet* cursorSet = nullptr;
+    bool ready = false, committed = false, notificationRequested = false;
+    bool replacesCursorSet = false;
+    int finalIndex = 0, finalUnits = 0;
+    bool finalNewTransaction = true;
+    String finalName; // Swapped with old metadata; destruction only after commit.
+    std::unique_ptr<ActionSet> newSet;
+    // Before commit these arrays BORROW old pointers. After atomic table swaps,
+    // retired owns only removed sets; swapped-out buffers contain no ownership.
+    OwnedArray<ActionSet> preparedTransactions, preparedStash, retired;
+
+    ~Impl()
+    {
+        preparedTransactions.clearQuick (false);
+        preparedStash.clearQuick (false);
+        if (! committed)
+            retired.clearQuick (false);
+        // committed retired + uncommitted newSet destruct on caller control only.
+    }
+    static void reserve (OwnedArray<ActionSet>& array, int count)
+    {
+        if (count < 0 || count > (std::numeric_limits<int>::max() - 8) / 3 * 2)
+            throw std::length_error ("Prepared history pointer-table capacity overflow");
+        if (count != 0)
+        {
+            array.ensureStorageAllocated (count);
+            // JUCE HeapBlock<...,false> does not throw for a null allocation.
+            // Fresh table only: verify storage BEFORE adding any borrowed owner.
+            if (array.begin() == nullptr)
+                throw std::bad_alloc();
+        }
+    }
+};
+
+UndoManager::PreparedHistoryMutation::PreparedHistoryMutation (std::unique_ptr<Impl> value)
+    : impl (std::move (value)) {}
+UndoManager::PreparedHistoryMutation::~PreparedHistoryMutation() = default;
+UndoManager::PreparedHistoryMutation::PreparedHistoryMutation (PreparedHistoryMutation&&) noexcept = default;
+UndoManager::PreparedHistoryMutation& UndoManager::PreparedHistoryMutation::operator= (PreparedHistoryMutation&&) noexcept = default;
+bool UndoManager::PreparedHistoryMutation::wasCommitted() const noexcept { return impl && impl->committed; }
+
+std::unique_ptr<UndoManager::PreparedHistoryMutation> UndoManager::prepareNewTransaction (
+    std::unique_ptr<UndoableAction> action, const String& name, int cachedNewUnits,
+    CachedActionUnits readUnits, void* readerContext)
+{
+    using Impl = PreparedHistoryMutation::Impl;
+    if (! action || ! readUnits || cachedNewUnits < 0 || preparedMutationDepth != 0 ||
+        isPerformingUndoRedo() || preparedMutationGenerationExhausted)
+        return {};
+    const auto expectedGeneration = preparedMutationGeneration;
+    int admittedNewUnits = -1;
+    if (! readUnits (*action, admittedNewUnits, readerContext) || admittedNewUnits < 0 ||
+        admittedNewUnits != cachedNewUnits || preparedMutationGeneration != expectedGeneration)
+        return {};
+    std::vector<int> costs;
+    costs.reserve (size_t (transactions.size()));
+    std::int64_t allUnits = 0;
+    auto costOf = [&] (const ActionSet& set, int& result)
+    {
+        std::int64_t total = 0;
+        for (auto* item : set.actions)
+        {
+            int units = -1;
+            if (! item || ! readUnits (*item, units, readerContext) || units < 0 ||
+                preparedMutationGeneration != expectedGeneration || preparedMutationDepth != 0)
+                return false;
+            total += units;
+            if (total > std::numeric_limits<int>::max())
+                return false;
+        }
+        result = int (total);
+        return true;
+    };
+    for (auto* set : transactions)
+    {
+        int units = 0;
+        if (! set || ! costOf (*set, units)) return {};
+        costs.push_back (units);
+        allUnits += units;
+        if (allUnits > std::numeric_limits<int>::max()) return {};
+    }
+    // Stashed actions are not in totalUnitsStored, but retire only caller-admitted
+    // action types; future normal stash restore retains its original exact owners.
+    for (auto* set : stashedFutureTransactions)
+    {
+        int ignored = 0;
+        if (! set || ! costOf (*set, ignored)) return {};
+    }
+    if (allUnits != totalUnitsStored || nextIndex < 0 || nextIndex > transactions.size())
+        return {};
+    auto ticket = std::make_unique<Impl>();
+    ticket->owner = this;
+    ticket->generation = expectedGeneration;
+    ticket->kind = Impl::Kind::newTransaction;
+    ticket->finalName = name;
+    ticket->finalNewTransaction = false;
+    ticket->newSet = std::make_unique<ActionSet> (name);
+    ticket->newSet->actions.ensureStorageAllocated (1);
+    if (ticket->newSet->actions.begin() == nullptr) throw std::bad_alloc();
+    ticket->newSet->actions.add (std::move (action)); // Reserved, ticket owns it.
+    ticket->cursorSet = ticket->newSet.get();
+    std::int64_t remaining = admittedNewUnits;
+    for (int index = 0; index < nextIndex; ++index) remaining += costs[size_t (index)];
+    if (remaining > std::numeric_limits<int>::max()) return {};
+    int prune = 0;
+    const int candidateCount = nextIndex + 1;
+    while (candidateCount - prune > 0 && remaining > maxNumUnitsToKeep &&
+           candidateCount - prune > minimumTransactionsToKeep)
+    {
+        if (prune >= nextIndex) return {}; // At least the new transaction survives.
+        remaining -= costs[size_t (prune++)];
+    }
+    Impl::reserve (ticket->preparedTransactions, candidateCount - prune);
+    const bool replacesFuture = nextIndex < transactions.size();
+    Impl::reserve (ticket->preparedStash, replacesFuture ? transactions.size() - nextIndex
+                                                        : stashedFutureTransactions.size());
+    if (stashedFutureTransactions.size() > std::numeric_limits<int>::max() - prune) return {};
+    Impl::reserve (ticket->retired, prune + (replacesFuture ? stashedFutureTransactions.size() : 0));
+    for (int index = 0; index < prune; ++index) ticket->retired.add (transactions[index]);
+    for (int index = prune; index < nextIndex; ++index) ticket->preparedTransactions.add (transactions[index]);
+    ticket->preparedTransactions.add (ticket->newSet.get());
+    if (replacesFuture)
+    {
+        for (int index = nextIndex; index < transactions.size(); ++index)
+            ticket->preparedStash.add (transactions[index]);
+        for (auto* set : stashedFutureTransactions) ticket->retired.add (set);
+    }
+    else
+        for (auto* set : stashedFutureTransactions) ticket->preparedStash.add (set);
+    ticket->finalIndex = ticket->preparedTransactions.size();
+    ticket->finalUnits = int (remaining);
+    if (preparedMutationGeneration != expectedGeneration || preparedMutationDepth != 0 ||
+        preparedMutationGenerationExhausted) return {};
+    ticket->ready = true;
+    return std::unique_ptr<PreparedHistoryMutation> (new PreparedHistoryMutation (std::move (ticket)));
+}
+
+std::unique_ptr<UndoManager::PreparedHistoryMutation> UndoManager::prepareUndoMutation()
+{
+    using Impl = PreparedHistoryMutation::Impl;
+    if (preparedMutationDepth != 0 || isPerformingUndoRedo() || preparedMutationGenerationExhausted || ! canUndo())
+        return {};
+    auto ticket = std::make_unique<Impl>();
+    ticket->owner = this;
+    ticket->generation = preparedMutationGeneration;
+    ticket->kind = Impl::Kind::undo;
+    ticket->cursorSet = getCurrentSet();
+    ticket->finalIndex = nextIndex - 1;
+    ticket->finalUnits = totalUnitsStored;
+    ticket->ready = true;
+    return std::unique_ptr<PreparedHistoryMutation> (new PreparedHistoryMutation (std::move (ticket)));
+}
+std::unique_ptr<UndoManager::PreparedHistoryMutation> UndoManager::prepareRedoMutation()
+{
+    using Impl = PreparedHistoryMutation::Impl;
+    if (preparedMutationDepth != 0 || isPerformingUndoRedo() || preparedMutationGenerationExhausted || ! canRedo())
+        return {};
+    auto ticket = std::make_unique<Impl>();
+    ticket->owner = this;
+    ticket->generation = preparedMutationGeneration;
+    ticket->kind = Impl::Kind::redo;
+    ticket->cursorSet = getNextSet();
+    ticket->finalIndex = nextIndex + 1;
+    ticket->finalUnits = totalUnitsStored;
+    ticket->ready = true;
+    return std::unique_ptr<PreparedHistoryMutation> (new PreparedHistoryMutation (std::move (ticket)));
+}
+
+std::unique_ptr<UndoManager::PreparedHistoryMutation> UndoManager::prepareHistoryReplacement (
+    bool undoing, std::unique_ptr<UndoableAction> replacement, int cachedNewUnits,
+    CachedActionUnits readUnits, void* readerContext)
+{
+    using Impl = PreparedHistoryMutation::Impl;
+    if (! replacement || ! readUnits || cachedNewUnits < 0) return {};
+    auto result = undoing ? prepareUndoMutation() : prepareRedoMutation();
+    if (! result) return {};
+    auto& ticket = *result->impl;
+    const auto expectedGeneration = ticket.generation;
+    const int selected = undoing ? nextIndex - 1 : nextIndex;
+    if (selected < 0 || selected >= transactions.size() ||
+        transactions[selected] != ticket.cursorSet || ticket.cursorSet->actions.size() != 1)
+        return {};
+    auto unitsOf = [&] (const ActionSet& set, int& answer)
+    {
+        std::int64_t total = 0;
+        for (auto* action : set.actions)
+        {
+            int units = -1;
+            if (! action || ! readUnits (*action, units, readerContext) || units < 0 ||
+                preparedMutationGeneration != expectedGeneration || preparedMutationDepth != 0)
+                return false;
+            total += units;
+            if (total > std::numeric_limits<int>::max()) return false;
+        }
+        answer = int (total); return true;
+    };
+    int admitted = -1;
+    if (! readUnits (*replacement, admitted, readerContext) || admitted != cachedNewUnits || admitted < 0 ||
+        ! isPreparedMutationCurrent (*result)) return {};
+    std::vector<int> costs;
+    costs.reserve (size_t (transactions.size()));
+    std::int64_t allUnits = 0;
+    for (auto* set : transactions)
+    {
+        int cost = 0;
+        if (! set || ! unitsOf (*set, cost)) return {};
+        costs.push_back (cost); allUnits += cost;
+        if (allUnits > std::numeric_limits<int>::max()) return {};
+    }
+    for (auto* set : stashedFutureTransactions)
+    {
+        int ignored = 0;
+        if (! set || ! unitsOf (*set, ignored)) return {};
+    }
+    if (allUnits != totalUnitsStored) return {};
+    std::int64_t remaining = allUnits - costs[size_t (selected)] + admitted;
+    int prune = 0;
+    while (remaining > maxNumUnitsToKeep && transactions.size() - prune > minimumTransactionsToKeep)
+    {
+        if (prune >= selected) return {}; // Never delete the replaced target/future.
+        remaining -= costs[size_t (prune++)];
+    }
+    if (remaining < 0 || remaining > std::numeric_limits<int>::max()) return {};
+    ticket.newSet = std::make_unique<ActionSet> (ticket.cursorSet->name);
+    ticket.newSet->time = ticket.cursorSet->time;
+    ticket.newSet->actions.ensureStorageAllocated (1);
+    if (ticket.newSet->actions.begin() == nullptr) throw std::bad_alloc();
+    ticket.newSet->actions.add (std::move (replacement));
+    Impl::reserve (ticket.preparedTransactions, transactions.size() - prune);
+    Impl::reserve (ticket.preparedStash, stashedFutureTransactions.size());
+    Impl::reserve (ticket.retired, prune + 1);
+    for (int index = 0; index < prune; ++index) ticket.retired.add (transactions[index]);
+    ticket.retired.add (ticket.cursorSet);
+    for (int index = prune; index < transactions.size(); ++index)
+        ticket.preparedTransactions.add (index == selected ? ticket.newSet.get() : transactions[index]);
+    for (auto* set : stashedFutureTransactions) ticket.preparedStash.add (set);
+    ticket.cursorSet = ticket.newSet.get();
+    ticket.replacesCursorSet = true;
+    ticket.finalIndex -= prune;
+    ticket.finalUnits = int (remaining);
+    if (! isPreparedMutationCurrent (*result)) return {};
+    return result;
+}
+
+bool UndoManager::isPreparedMutationCurrent (const PreparedHistoryMutation& value) const noexcept
+{
+    return value.impl && value.impl->owner == this && value.impl->ready && ! value.impl->committed &&
+           preparedMutationDepth == 0 && ! isPerformingUndoRedo() && ! preparedMutationGenerationExhausted &&
+           value.impl->generation == preparedMutationGeneration;
+}
+bool UndoManager::getPreparedMutationActions (const PreparedHistoryMutation& value,
+                                               Array<const UndoableAction*>& actions) const
+{
+    if (! isPreparedMutationCurrent (value)) return false;
+    for (auto* action : value.impl->cursorSet->actions) actions.add (action);
+    return true;
+}
+bool UndoManager::commitPreparedMutation (PreparedHistoryMutation& value,
+                                           PreparedCanonicalApply apply, void* context) noexcept
+{
+    using Impl = PreparedHistoryMutation::Impl;
+    if (! apply || ! isPreparedMutationCurrent (value)) return false;
+    const PreparedMutationScope mutationScope (*this);
+    auto& ticket = *value.impl;
+    apply (context); // Caller-admitted canonical aggregate swap, exactly once.
+    if (ticket.kind == Impl::Kind::newTransaction || ticket.replacesCursorSet)
+    {
+        ticket.newSet.release(); // New action ownership goes to the real manager table.
+        transactions.swapWith (ticket.preparedTransactions);
+        stashedFutureTransactions.swapWith (ticket.preparedStash);
+        // DO NOT use removeAndReturn: pinned OwnedArray may shrink/reallocate.
+        // Remove duplicate pointer ownership only; keep the old buffers until retirement.
+        ticket.preparedTransactions.clearQuick (false);
+        ticket.preparedStash.clearQuick (false);
+    }
+    newTransactionName.swapWith (ticket.finalName); // Old name retained in ticket.
+    nextIndex = ticket.finalIndex;
+    totalUnitsStored = ticket.finalUnits;
+    newTransaction = ticket.finalNewTransaction;
+    ticket.committed = true;
+    ticket.ready = false;
+    return true;
+}
+bool UndoManager::notifyPreparedMutation (PreparedHistoryMutation& value)
+{
+    if (! value.impl || value.impl->owner != this || ! value.impl->committed || value.impl->notificationRequested)
+        return false;
+    sendChangeMessage(); // Fallible and deliberately outside canonical commit.
+    value.impl->notificationRequested = true;
+    return true;
+}
