+//==============================================================================
+UndoManager::UndoManager (int maxNumberOfUnitsToKeep, int minimumTransactions)
+{
+    setMaxNumberOfStoredUnits (maxNumberOfUnitsToKeep, minimumTransactions);
+}
+
+UndoManager::~UndoManager()
+{
+}
