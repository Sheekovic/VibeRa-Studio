+bool DeviceManager::installPreparationFence (void* owner, PreparationFence callback) noexcept
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    const auto* messageManager = juce::MessageManager::getInstanceWithoutCreating();
+    if (!messageManager || !messageManager->isThisTheMessageThread())
+        return false;
+    if (owner == nullptr || callback == nullptr || preparationFenceActive)
+        return false;
+    if (preparationFenceOwner != nullptr)
+        return preparationFenceOwner == owner && preparationFence == callback;
+    preparationFenceOwner = owner;
+    preparationFence = callback;
+    return true;
+}
+
+bool DeviceManager::removePreparationFence (void* owner) noexcept
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    const auto* messageManager = juce::MessageManager::getInstanceWithoutCreating();
+    if (!messageManager || !messageManager->isThisTheMessageThread())
+        return false;
+    if (owner == nullptr || owner != preparationFenceOwner || preparationFenceActive)
+        return false;
+    preparationFence = nullptr;
+    preparationFenceOwner = nullptr;
+    return true;
+}
+
+bool DeviceManager::retryPreparationFence (void* owner)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    const auto* messageManager = juce::MessageManager::getInstanceWithoutCreating();
+    if (! messageManager || ! messageManager->isThisTheMessageThread() ||
+        owner == nullptr || owner != preparationFenceOwner || preparationFence == nullptr ||
+        preparationFenceActive || preparationFenceStatus != PreparationFenceStatus::refused ||
+        ! isSuspended.load() || deviceManager.getCurrentAudioDevice() == nullptr ||
+        prepareToStartCaller->isUpdatePending())
+        return false;
+    prepareToStartCaller->triggerAsyncUpdate();
+    return true;
+}
+
+bool DeviceManager::runPreparationFence() noexcept
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    const auto* messageManager = juce::MessageManager::getInstanceWithoutCreating();
+    if (!messageManager || !messageManager->isThisTheMessageThread())
+        return false;
+    if (preparationFenceActive)
+    {
+        preparationFenceReentered = true;
+        preparationFenceStatus = PreparationFenceStatus::reentrant;
+        return false;
+    }
+    if (preparationFence == nullptr)
+    {
+        preparationFenceStatus = PreparationFenceStatus::none;
+        return true;
+    }
+    const juce::ScopedValueSetter<bool> active (preparationFenceActive, true);
+    preparationFenceReentered = false;
+    const bool accepted = preparationFence (preparationFenceOwner);
+    if (preparationFenceReentered)
+    {
+        preparationFenceStatus = PreparationFenceStatus::reentrant;
+        return false;
+    }
+    preparationFenceStatus = accepted ? PreparationFenceStatus::passed : PreparationFenceStatus::refused;
+    return accepted;
+}
