+// ORIGINAL bounded telemetry. Pinned native lifecycle serializes start/I/O/stop;
+// publication CAS refuses conflicting writers. Default audio splitting is unchanged.
+bool AudioDeviceManager::beginPhysicalPublication() noexcept
+{
+    auto& c = *physicalCallbackCounters;
+    auto revision = c.revision.load (std::memory_order_seq_cst);
+    if (revision >= std::numeric_limits<uint64>::max() - 2)
+    {
+        c.exhausted.store (true, std::memory_order_seq_cst);
+        return false;
+    }
+    // One bounded ownership attempt. A conflicting writer never touches payload.
+    // Sticky conflict requires explicit quiesced manager recovery, not expiry.
+    if ((revision & 1u) != 0 || ! c.revision.compare_exchange_strong (revision, revision + 1,
+                                                                    std::memory_order_seq_cst))
+    {
+        c.writerConflict.store (true, std::memory_order_seq_cst);
+        return false;
+    }
+    return true;
+}
+void AudioDeviceManager::endPhysicalPublication() noexcept
+{
+    auto& value = physicalCallbackCounters->revision;
+    value.store (value.load (std::memory_order_seq_cst) + 1, std::memory_order_seq_cst);
+}
+void AudioDeviceManager::physicalDeviceStarting (int configuredFrames) noexcept
+{
+    auto& c = *physicalCallbackCounters;
+    if (! beginPhysicalPublication())
+        return;
+    const auto previous = c.epoch.load (std::memory_order_seq_cst);
+    if (previous == std::numeric_limits<uint64>::max())
+        c.exhausted.store (true, std::memory_order_seq_cst);
+    else
+        c.epoch.store (previous + 1, std::memory_order_seq_cst);
+    c.configured.store (configuredFrames, std::memory_order_seq_cst);
+    c.frames.store (0, std::memory_order_seq_cst);
+    c.maximum.store (0, std::memory_order_seq_cst);
+    c.active.store (configuredFrames > 0, std::memory_order_seq_cst);
+    endPhysicalPublication();
+}
+void AudioDeviceManager::physicalCallbackStarting (int originalFrames) noexcept
+{
+    auto& c = *physicalCallbackCounters;
+    if (! beginPhysicalPublication())
+        return;
+    const auto serial = c.serial.load (std::memory_order_seq_cst);
+    if (serial == std::numeric_limits<uint64>::max())
+        c.exhausted.store (true, std::memory_order_seq_cst);
+    else
+        c.serial.store (serial + 1, std::memory_order_seq_cst);
+    c.frames.store (originalFrames, std::memory_order_seq_cst);
+    c.maximum.store (jmax (originalFrames, c.maximum.load (std::memory_order_seq_cst)), std::memory_order_seq_cst);
+    endPhysicalPublication();
+}
+void AudioDeviceManager::physicalDeviceStopped() noexcept
+{
+    if (! beginPhysicalPublication())
+        return;
+    physicalCallbackCounters->active.store (false, std::memory_order_seq_cst);
+    endPhysicalPublication();
+}
+AudioDeviceManager::PhysicalCallbackReader AudioDeviceManager::getPhysicalCallbackReader() const
+{
+    return PhysicalCallbackReader { physicalCallbackCounters };
+}
+bool AudioDeviceManager::PhysicalCallbackReader::read (PhysicalCallbackSnapshot& out) const noexcept
+{
+    return state != nullptr && AudioDeviceManager::readPhysicalCounters (*state, out);
+}
+bool AudioDeviceManager::readPhysicalCallbackSnapshot (PhysicalCallbackSnapshot& out) const noexcept
+{
+    return readPhysicalCounters (*physicalCallbackCounters, out);
+}
+bool AudioDeviceManager::readPhysicalCounters (const PhysicalCallbackCounters& c,
+                                               PhysicalCallbackSnapshot& out) noexcept
+{
+    for (int attempt = 0; attempt < 3; ++attempt)
+    {
+        const auto before = c.revision.load (std::memory_order_seq_cst);
+        if ((before & 1u) != 0)
+            continue;
+        PhysicalCallbackSnapshot value;
+        value.deviceEpoch = c.epoch.load (std::memory_order_seq_cst);
+        value.callbackSerial = c.serial.load (std::memory_order_seq_cst);
+        value.configuredFrames = c.configured.load (std::memory_order_seq_cst);
+        value.outerFrames = c.frames.load (std::memory_order_seq_cst);
+        value.maximumOuterFrames = c.maximum.load (std::memory_order_seq_cst);
+        value.ownerAlive = c.ownerAlive.load (std::memory_order_seq_cst);
+        value.active = value.ownerAlive && c.active.load (std::memory_order_seq_cst);
+        value.countersExhausted = c.exhausted.load (std::memory_order_seq_cst);
+        value.writerConflict = c.writerConflict.load (std::memory_order_seq_cst);
+        if (c.revision.load (std::memory_order_seq_cst) == before)
+        {
+            out = value;
+            return true;
+        }
+    }
+    return false;
+}
+AudioDeviceManager::PhysicalCallbackBound AudioDeviceManager::getCurrentPhysicalCallbackBound() const
+{
+    return currentPhysicalBound.load (std::memory_order_acquire);
 }
 
