+        // Construct/copy/retire only on CONTROL, with graph readers quiesced.
+        // read() does not copy ownership, allocate, lock or destroy anything.
+        std::shared_ptr<const PhysicalCallbackCounters> state;
+    };
+    // CONTROL only. Pin once in the prepared session alongside its immutable
+    // budget/epoch; never rebind an old budget to a different reader source.
+    PhysicalCallbackReader getPhysicalCallbackReader() const;
+    enum class PhysicalCallbackBound { unknown, currentBufferSize };
+    // Atomic staged provenance from the actual CONTROL factory, never a name match.
