+            dst.getNumChannels() == 0 || dst.getNumChannels() != fifo.getNumChannels() || !reader || !expectedWriter)
+            return TerminalDrainStatus::shape;
+        if (!hasConfiguration (expectedDelay, expectedRate, int (dst.getNumChannels())))
+            return TerminalDrainStatus::configuration;
