+void LockFreeMultiThreadedNodePlayer::requireNoFixedPreparation() const
+{
+    if (fixedPreparationActive) throw std::logic_error("Reentrant player mutation during fixed graph preparation");
+}
+LockFreeMultiThreadedNodePlayer::ReadyConfiguration LockFreeMultiThreadedNodePlayer::readyConfiguration() const noexcept
+{
+    return {sampleRate.load(std::memory_order_acquire), blockSize.load(std::memory_order_acquire),
+            numThreadsToUse.load(std::memory_order_acquire), useMemoryPool.load(std::memory_order_acquire),
+            nodeMemorySharingEnabled, disableLatencyComp.load(std::memory_order_acquire)};
+}
+void LockFreeMultiThreadedNodePlayer::ensureReadyOwner()
+{
+    if (!readyOwnerIdentity) readyOwnerIdentity = std::make_shared<ReadyOwnerIdentity>(ReadyOwnerIdentity{this});
+}
+LockFreeMultiThreadedNodePlayer::ReadyGraphStatus LockFreeMultiThreadedNodePlayer::fixedGraphPreparationReadiness() const noexcept
+{
+    if (fixedPreparationActive) return ReadyGraphStatus::preparationBusy;
+    if (readyGenerationExhausted) return ReadyGraphStatus::generationExhausted;
+    if (!rootNode || !lastGraphPosted || !threadPool || !std::isfinite(getSampleRate()) ||
+        getSampleRate() <= 0 || getBlockSize() <= 0) return ReadyGraphStatus::noCurrentGraph;
+    if (useMemoryPool.load(std::memory_order_acquire)) return ReadyGraphStatus::pooledMemoryUnsupported;
+    return ReadyGraphStatus::ready;
+}
+LockFreeMultiThreadedNodePlayer::ReadyGraph LockFreeMultiThreadedNodePlayer::prepareFixedGraph(std::unique_ptr<Node> node)
+{
+    if (fixedGraphPreparationReadiness() != ReadyGraphStatus::ready || !node)
+        throw std::invalid_argument("Fixed graph preparation requires an existing supported non-pooled graph");
+    ensureReadyOwner();
+    ReadyGraph result;
+    result.owner = readyOwnerIdentity;
+    result.configuration = readyConfiguration();
+    result.generation = readyMutationGeneration;
+    const juce::ScopedValueSetter<bool> preparing(fixedPreparationActive, true);
+    // Last POSTED and actual DSP-adopted scopes can differ: B may be queued
+    // while the callback still uses A. The sole CONTROL owner prevents post,
+    // retirement or clear during this snapshot's use. Callback adoption only
+    // transfers old ownership to pending storage; it never destroys holders.
+    const auto* adopted = threadPool->getCurrentNodeForPreparation();
+    const auto* adoptedGraph = adopted ? adopted->graph.get() : nullptr;
+    const auto contains = [] (const NodeGraph* scope, const Node* candidate)
+    {
+        return scope && std::find(scope->orderedNodes.begin(), scope->orderedNodes.end(), candidate) !=
+                        scope->orderedNodes.end();
+    };
+    // Sharing live DSP BANKS via existing preparation contracts is permitted;
+    // re-initialising the same actual Node is not. Refuse borrowed objects in
+    // either scope before transforms/initialise can touch runtime bookkeeping.
+    for (auto* candidate : getNodes(*node, VertexOrdering::postordering))
+        if (contains(lastGraphPosted, candidate) || contains(adoptedGraph, candidate))
+            throw std::invalid_argument("Fixed graph candidate shares a posted or adopted Node object");
+    auto graph = node_player_utils::prepareToPlay(std::move(node), lastGraphPosted,
+                         result.configuration.rate, result.configuration.block,
+                         nullptr, nullptr, result.configuration.sharing, result.configuration.disableLatency);
+    result.storage = prepareGraphHolder(std::move(graph), false, result.configuration.threads, result.configuration.block);
+    if (result.generation != readyMutationGeneration || result.configuration != readyConfiguration() || readyGenerationExhausted)
+        throw std::logic_error("Player configuration changed while preparing a fixed graph");
+    return result;
+}
+LockFreeMultiThreadedNodePlayer::GraphRetirementSlot LockFreeMultiThreadedNodePlayer::makeGraphRetirementSlot()
+{
+    ensureReadyOwner();
+    return GraphRetirementSlot(readyOwnerIdentity);
+}
+LockFreeMultiThreadedNodePlayer::ReadyGraphStatus LockFreeMultiThreadedNodePlayer::validateReadyGraph(
+    const ReadyGraph& candidate, const GraphRetirementSlot& retired) const noexcept
+{
+    if (fixedPreparationActive) return ReadyGraphStatus::preparationBusy;
+    if (candidate.empty()) return ReadyGraphStatus::emptyCandidate;
+    if (!candidate.owner || candidate.owner != readyOwnerIdentity || candidate.owner->player != this)
+        return ReadyGraphStatus::foreignOwner;
+    if (!retired.owner || retired.owner != readyOwnerIdentity || retired.owner->player != this)
+        return ReadyGraphStatus::foreignRetirementSlot;
+    if (!retired.empty()) return ReadyGraphStatus::retirementSlotNotEmpty;
+    if (readyGenerationExhausted) return ReadyGraphStatus::generationExhausted;
+    if (candidate.generation != readyMutationGeneration) return ReadyGraphStatus::staleGeneration;
+    if (candidate.configuration != readyConfiguration()) return ReadyGraphStatus::configurationChanged;
+    return fixedGraphPreparationReadiness();
+}
+LockFreeMultiThreadedNodePlayer::ReadyGraphStatus LockFreeMultiThreadedNodePlayer::publishReadyGraph(
+    ReadyGraph& candidate, GraphRetirementSlot& retired) noexcept
+{
+    const auto admitted = validateReadyGraph(candidate, retired);
+    if (admitted != ReadyGraphStatus::ready) return admitted;
+    auto* nextRoot = candidate.storage->graph->rootNode.get();
+    auto* nextGraph = candidate.storage->graph.get();
+    auto* nextPool = candidate.storage->audioBufferPool.get();
+    const auto latency = candidate.storage->preparedLatencySamples;
+    static_assert(std::is_nothrow_move_assignable_v<decltype(retired.storage)>);
+    // Slot is EMPTY and both identity pins stay where they are: no old owner or
+    // resource can be released as a side-effect of these unique-pointer moves.
+    auto old = preparedNodeObject.pushPreparedNonRealTime(std::move(candidate.storage));
+    retired.storage = std::move(old);
+    rootNode = nextRoot;
+    lastGraphPosted = nextGraph;
+    lastAudioBufferPoolPosted = nextPool; // Fixed path is explicitly non-pooled.
+    preparedLatencySamples = latency;
+    invalidateReadyGraphs();
+    return ReadyGraphStatus::ready;
+}
+bool LockFreeMultiThreadedNodePlayer::retireReadyGraph(GraphRetirementSlot& retired) noexcept
+{
+    if (!retired.owner || retired.owner != readyOwnerIdentity || retired.owner->player != this) return false;
+    if (retired.storage)
+    {
+        threadPool->waitForThreadsToQuiesce();
+        retired.storage.reset();
+    }
+    return true;
+}
+LockFreeMultiThreadedNodePlayer::GraphRetirementSlot::GraphRetirementSlot(GraphRetirementSlot&& other) noexcept
+    : owner(std::move(other.owner)), storage(std::move(other.storage)) {}
+LockFreeMultiThreadedNodePlayer::GraphRetirementSlot& LockFreeMultiThreadedNodePlayer::GraphRetirementSlot::operator=(GraphRetirementSlot&& other) noexcept
+{
+    if (this != &other)
+    {
+        releaseOnControlThread();
+        owner = std::move(other.owner);
+        storage = std::move(other.storage);
+    }
+    return *this;
+}
+void LockFreeMultiThreadedNodePlayer::GraphRetirementSlot::releaseOnControlThread() noexcept
+{
+    if (storage && owner && owner->player) owner->player->retireReadyGraph(*this);
+    // If the player is gone, its destructor already stopped its pool threads.
+    // Caller must still retain external Edit/plugin owners for graph lifetime.
+    storage.reset();
+}
+LockFreeMultiThreadedNodePlayer::GraphRetirementSlot::~GraphRetirementSlot() noexcept { releaseOnControlThread(); }
