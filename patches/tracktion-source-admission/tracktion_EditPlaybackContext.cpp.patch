+SourceBurstSession::Status SourceBurstSession::claim (juce::AudioDeviceManager& manager, EditPlaybackContext* context) noexcept
+{
+    if (impl->managerIdentity != &manager || !context) return Status::invalidConfiguration;
+    if (impl->contextIdentity) return Status::alreadyClaimed;
+    if (impl->current.retired) return Status::retired;
+    if (impl->current.failed) return impl->current.status;
+    juce::AudioDeviceManager::PhysicalCallbackSnapshot now;
+    if (!impl->reader.read (now)) return Status::telemetryUnavailable;
+    if (!now.ownerAlive) return Status::managerReleased;
+    if (now.writerConflict) return Status::writerConflict;
+    if (now.countersExhausted) return Status::counterExhausted;
+    if (!now.active) return Status::deviceStopped;
+    if (now.deviceEpoch != impl->config.deviceEpoch || now.configuredFrames != impl->config.deviceFrames)
+        return Status::deviceChanged;
+    // Capture at INSTALL, not just preparation: preparing may precede an
+    // in-flight physical callback by many serials. Never admit its suffix.
+    impl->current.activationAfterSerial = now.callbackSerial;
+    impl->lastClosedSerial = now.callbackSerial;
+    impl->contextIdentity = context;
+    impl->publish();
+    return Status::prepared;
+}
