+bool sourceBurstConvertedFrames (int frames, double speed, int& result) noexcept
+{
+    if (frames <= 0 || !std::isfinite (speed) || speed < -10.0 || speed > 10.0)
+        return false;
+    const auto value = frames * (1.0 + speed * .01);
+    if (!std::isfinite (value) || value <= 0 || value > double (std::numeric_limits<int>::max()) - .5)
+        return false;
+    const auto converted = juce::roundToInt (value);
+    if (converted <= 0) return false;
+    result = converted;
+    return true;
+}
+juce::int64 sourceBurstUpper (int frames, int block, int scale) noexcept
+{
+    if (frames <= 0 || block <= 0 || scale < 900000 || scale > 1100000) return -1;
+    const auto ceiling = [scale] (int n) noexcept { return (juce::int64 (n) * scale + 999999) / 1000000; };
+    return juce::int64 (frames / block) * ceiling (block) + (frames % block ? ceiling (frames % block) : 0);
+}
