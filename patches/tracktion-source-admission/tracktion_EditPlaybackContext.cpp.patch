+SourceBurstSession::Status SourceBurstSession::prepare (juce::AudioDeviceManager& manager,
+    const Configuration& config, std::shared_ptr<Observer> observer, Ptr& output) noexcept
+{
+    try
+    {
+        if (!observer || !config.generation || !config.deviceEpoch || !std::isfinite (config.sampleRate) ||
+            config.sampleRate < 8000 || config.sampleRate > 192000 || config.deviceFrames <= 0 ||
+            config.maximumPhysicalFrames <= 0 || config.maximumSourceFrames <= 0 ||
+            config.maximumSourceScalePpm < 900000 || config.maximumSourceScalePpm > 1100000)
+            return Status::invalidConfiguration;
+        const auto upper = sourceBurstUpper (config.maximumPhysicalFrames, config.deviceFrames, config.maximumSourceScalePpm);
+        if (upper <= 0 || upper > config.maximumSourceFrames) return Status::sourceBurstExceeded;
+        auto* device = manager.getCurrentAudioDevice(); // CONTROL only.
+        auto reader = manager.getPhysicalCallbackReader();
+        juce::AudioDeviceManager::PhysicalCallbackSnapshot state;
+        if (!reader.read (state)) return Status::telemetryUnavailable;
+        if (!state.ownerAlive) return Status::managerReleased;
+        if (state.writerConflict) return Status::writerConflict;
+        if (state.countersExhausted) return Status::counterExhausted;
+        if (!state.active || !device) return Status::deviceStopped;
+        if (state.deviceEpoch != config.deviceEpoch || state.configuredFrames != config.deviceFrames || device->getCurrentBufferSizeSamples() != config.deviceFrames)
+            return Status::deviceChanged;
+        if (device->getCurrentSampleRate() != config.sampleRate) return Status::rateChanged;
+        if (state.maximumOuterFrames > config.maximumPhysicalFrames) return Status::physicalBurstExceeded;
+        Ptr prepared (new SourceBurstSession (std::make_unique<Impl> (config, manager, std::move (reader), std::move (observer))));
+        output = std::move (prepared);
+        return Status::prepared;
+    }
+    catch (const std::bad_alloc&) { return Status::allocationFailed; }
+    catch (...) { return Status::preparationFailed; } // No fabricated ready result or output replacement.
