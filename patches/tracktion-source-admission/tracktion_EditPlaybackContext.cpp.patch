+bool SourceBurstSession::read (Outcome& out) const noexcept
+{
+    const auto& state = *impl;
+    for (int attempt = 0; attempt < 3; ++attempt)
+    {
+        const auto before = state.publication.load (std::memory_order_seq_cst);
+        if (before & 1) continue;
+        std::array<juce::uint64, 17> values {};
+        for (size_t i = 0; i < values.size(); ++i) values[i] = state.fields[i].load (std::memory_order_seq_cst);
+        if (state.publication.load (std::memory_order_seq_cst) != before) continue;
+        Outcome result;
+        result.status = Status (values[0]); result.generation = values[1]; result.deviceEpoch = values[2];
+        result.physicalSerial = values[3]; result.physicalFrames = int (values[4]); result.sourceQuota = int (values[5]);
+        result.deviceOffset = int (values[6]); result.sourceProcessed = int (values[7]);
+        result.sliceDeviceFrames = int (values[8]); result.sliceSourceFrames = int (values[9]);
+        result.metadataKnown = (values[10] & 1) != 0; result.scopeOpen = (values[10] & 2) != 0;
+        result.failed = (values[10] & 4) != 0; result.retired = (values[10] & 8) != 0;
+        result.offsetKnown = (values[10] & 16) != 0;
+        result.activationAfterSerial = values[11]; result.observedEpoch = values[12];
+        result.observedSerial = values[13]; result.observedPhysicalFrames = int (values[14]);
+        result.observedOffset = int (values[15]);
+        out = result; return true;
+    }
