+SourceBurstSession::Status DeviceManager::installSourceBurstSession (EditPlaybackContext& context, SourceBurstSession::Ptr candidate)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    SourceBurstSession::Ptr retired;
+    {
+        const std::unique_lock sl (contextLock); // CONTROL; the existing callback exclusion.
+        if (!activeContexts.contains (&context)) return SourceBurstSession::Status::contextUnavailable;
+        if (context.sourceBurstSession == candidate) return SourceBurstSession::Status::prepared;
+        if (context.sourceBurstSession && context.sourceBurstSession->scopeOpen()) return SourceBurstSession::Status::scopeInProgress;
+        if (candidate)
+        {
+            auto* device = deviceManager.getCurrentAudioDevice(); // CONTROL only.
+            if (!device) return SourceBurstSession::Status::deviceStopped;
+            const auto prepared = context.prepareSourceBurstResources (candidate->configuration(),
+                device->getActiveOutputChannels().countNumberOfSetBits());
+            if (prepared != SourceBurstSession::Status::prepared) return prepared;
+            const auto status = candidate->claim (deviceManager, &context);
+            if (status != SourceBurstSession::Status::prepared) return status;
+        }
+        retired = std::move (context.sourceBurstSession);
+        context.sourceBurstSession = std::move (candidate); // No owner destruction under the lock.
+    }
+    if (retired) retired->retire (SourceBurstSession::Status::retired);
+    return SourceBurstSession::Status::prepared;
+}
