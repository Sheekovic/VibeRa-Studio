+    void processBoundedMidi (ProcessContext& pc, const tracktion::MidiMessageArray& inputMidi)
+    {
+        pc.buffers.midi.clear();
+        const auto count = pc.referenceSampleRange.getLength();
+        if (count <= 0 || uint64_t (count) > std::numeric_limits<uint32_t>::max() ||
+            !midiHistoryRaw->beginBlock (pc.referenceSampleRange.getStart(), uint32_t (count), inputMidi.isAllNotesOff))
+        {
+            if (count <= 0 || uint64_t (count) > std::numeric_limits<uint32_t>::max())
+                midiHistoryRaw->reject (vibera::dsp::MidiHistoryFailure::invalidBlock);
+            pc.buffers.midi.isAllNotesOff = true;
+            return;
+        }
+        const auto& configuration = midiHistoryRaw->configuration();
+        for (const auto& message : inputMidi)
+        {
+            const auto sample = message.getTimeStamp() * configuration.sampleRate;
+            if (!std::isfinite (sample) || sample < 0 || sample >= double (count))
+            {
+                midiHistoryRaw->reject (vibera::dsp::MidiHistoryFailure::invalidTimestamp);
+                continue;
+            }
+            const auto frame = std::llround (sample);
+            if (frame < 0 || frame >= count)
+            {
+                midiHistoryRaw->reject (vibera::dsp::MidiHistoryFailure::invalidTimestamp);
+                continue;
+            }
+            const auto size = message.getRawDataSize();
+            if (size < 1 || size > 3)
+            {
+                midiHistoryRaw->reject (vibera::dsp::MidiHistoryFailure::unsupportedPayload);
+                continue;
+            }
+            midiHistoryRaw->enqueue (uint32_t (frame), uint32_t (requestedDelay), message.mpeSourceID,
+                {message.getRawData(), size_t (size)});
+        }
+        const auto batch = midiHistoryRaw->drain();
+        if (batch.events.size() > configuration.limits.outputEvents)
+        {
+            midiHistoryRaw->reject (vibera::dsp::MidiHistoryFailure::outputCapacity);
+            pc.buffers.midi.isAllNotesOff = true;
+            return; // No partial output can precede the safety panic.
+        }
+        for (const auto& event : batch.events)
+        {
+            const auto frame = event.due - batch.reference;
+            juce::MidiMessage message (event.bytes.data(), int (event.size), double (frame) / configuration.sampleRate);
+            pc.buffers.midi.addMidiMessage (std::move (message), event.source);
+        }
+        pc.buffers.midi.isAllNotesOff = batch.allNotesOff;
+    }
