+    void prepareBoundedMidi (const PlaybackInitialisationInfo& info)
+    {
+        const auto limits = info.nodeGraph.rootNode->getMidiCompensationHistoryLimits();
+        LatencyNode* old = nullptr;
+        if (retained.key.valid() && info.nodeGraphToReplace)
+            for (auto* node : info.nodeGraphToReplace->orderedNodes)
+                if (auto* tap = dynamic_cast<LatencyNode*> (node); tap && tap->retained.key == retained.key)
+                {
+                    if (old) throw std::invalid_argument ("Ambiguous old bounded MIDI edge");
+                    old = tap;
+                }
+        if (old && old->midiHistory && (!limits.enabled() || !retained.carryMidi))
+            throw std::invalid_argument ("Cannot abandon retained MIDI state during graph preparation");
+        if (!limits.enabled() || !retained.carryMidi) return;
+        if (!retained.key.valid() || requestedDelay < 0 || uint32_t (requestedDelay) > retained.maximumDelay)
+            throw std::invalid_argument ("Bounded MIDI edge needs stable identity/delay capacity");
+        size_t bytes = 0, matches = 0;
+        auto admit = [&] (size_t amount)
+        {
+            if (bytes > limits.graphBytes || amount > limits.graphBytes - bytes)
+                throw std::length_error ("Bounded MIDI graph storage exceeds explicit budget");
+            bytes += amount;
+        };
+        for (auto* node : info.nodeGraph.orderedNodes)
+        {
+            // Pinned JUCE ArrayBase::ensureAllocatedSize reserve rounding.
+            const size_t reserved = (size_t (limits.outputEvents) + limits.outputEvents / 2 + 8) & ~size_t (7);
+            admit (reserved * sizeof (tracktion::MidiMessageWithSource));
+            if (auto* tap = dynamic_cast<LatencyNode*> (node); tap && tap->retained.carryMidi)
+            {
+                if (!tap->retained.key.valid()) throw std::invalid_argument ("Unidentified bounded MIDI edge");
+                admit (vibera::dsp::MidiCompensationHistory::storageBytes (limits));
+                matches += tap->retained.key == retained.key;
+            }
+        }
+        if (matches != 1) throw std::invalid_argument ("Ambiguous candidate bounded MIDI edge");
+        const vibera::dsp::MidiHistoryConfiguration desired {retained.key, info.sampleRate,
+            retained.maximumDelay, uint32_t (info.blockSize), limits};
+        if (old)
