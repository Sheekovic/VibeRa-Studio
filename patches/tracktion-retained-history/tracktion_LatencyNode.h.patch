+    static size_t storageBytes (uint32_t maximumDelay, int channels, bool includeScratch)
+    {
+        if (channels <= 0)
+            throw std::invalid_argument ("Compensation audio edge has no channels");
+        const uint64_t frames = uint64_t (maximumDelay) + (includeScratch ? 3 : 1);
+        if (frames > std::numeric_limits<size_t>::max() / sizeof(float) / uint64_t (channels))
+            throw std::length_error ("Compensation history size overflow");
+        return size_t (frames * sizeof(float) * uint64_t (channels));
+    }
+    void prepareHistory (const PlaybackInitialisationInfo& info)
+    {
+        if (!retained.key.valid() || retained.maximumDelay == 0 || requestedDelay < 0 ||
+            uint32_t (requestedDelay) > retained.maximumDelay ||
+            info.nodeGraph.rootNode->getAudioCompensationHistoryMaximumDelay() != retained.maximumDelay)
+            throw std::invalid_argument ("Invalid/out-of-capacity prepared audio compensation edge");
+        std::vector<vibera::dsp::CompensationEdge> newEdges;
+        std::vector<std::shared_ptr<vibera::dsp::CompensationHistory>> oldBanks;
+        size_t total = 0;
+        const auto budget = info.nodeGraph.rootNode->getAudioCompensationHistoryBudget();
+        for (auto* node : info.nodeGraph.orderedNodes)
+            if (auto* tap = dynamic_cast<LatencyNode*> (node); tap && tap->historyEnabled)
+            {
+                newEdges.push_back (tap->retained.key);
+                const auto bytes = storageBytes (tap->retained.maximumDelay, tap->input->getNodeProperties().numberOfChannels, true);
+                if (total > budget || bytes > budget - total)
+                    throw std::length_error ("Candidate audio compensation histories exceed graph budget");
+                total += bytes;
+            }
+        LatencyNode* oldMatch = nullptr;
+        if (info.nodeGraphToReplace)
+            for (auto* node : info.nodeGraphToReplace->orderedNodes)
+                if (auto* tap = dynamic_cast<LatencyNode*> (node); tap && tap->historyEnabled && tap->history)
+                {
+                    oldBanks.push_back (tap->history); // Immutable config + handles ONLY. No cursor/PCM copy.
+                    if (tap->retained.key == retained.key)
+                    {
+                        if (oldMatch) throw std::invalid_argument ("Ambiguous old audio compensation edge");
+                        oldMatch = tap;
+                    }
+                }
+        const auto channels = input->getNodeProperties().numberOfChannels;
+        const vibera::dsp::CompensationConfiguration desired { retained.key, info.sampleRate, uint32_t (channels), retained.maximumDelay };
+        auto selected = vibera::dsp::selectCompensationHistory (desired, oldBanks, newEdges);
+        reuse = selected.result;
+        if (reuse == vibera::dsp::CompensationReuse::ambiguousEdge || reuse == vibera::dsp::CompensationReuse::incompatibleConfiguration)
+            throw std::invalid_argument ("Ambiguous or incompatible retained audio history; admission refused");
+        history = selected.bank ? std::move (selected.bank)
+                                : std::make_shared<vibera::dsp::CompensationHistory> (desired, storageBytes (retained.maximumDelay, channels, false));
+        historyRaw = history.get();
+        frameInput.resize (size_t (channels));
+        frameOutput.resize (size_t (channels));
+        if (retained.carryMidi && requestedDelay > 0)
+        {
+            midiProcessor = std::make_shared<LatencyProcessor>();
+            midiProcessor->setLatencyNumSamples (requestedDelay);
+            midiProcessor->prepareToPlay (info.sampleRate, info.blockSize, 0);
+            if (oldMatch && oldMatch->midiProcessor && midiProcessor->hasSameConfigurationAs (*oldMatch->midiProcessor))
+                midiProcessor = oldMatch->midiProcessor;
+            else
+                midiQueueReset = oldMatch != nullptr;
+        }
+        else if (retained.carryMidi && oldMatch && oldMatch->requestedDelay != requestedDelay)
+            midiQueueReset = true;
+    }
