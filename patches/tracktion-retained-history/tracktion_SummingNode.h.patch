+    bool createRetainedLatencyNodes (uint32_t maximumDelay)
+    {
+        int maximum = 0;
+        for (auto* node : nodes)
+            maximum = std::max (maximum, LatencyNode::logicalInputFor (node, this)->getNodeProperties().latencyNumSamples);
+        const auto consumerID = getNodeProperties().nodeID;
+        bool changed = false;
+        for (size_t port = 0; port < nodes.size(); ++port)
+        {
+            auto*& node = nodes[port];
+            auto* logical = LatencyNode::logicalInputFor (node, this);
+            const auto props = logical->getNodeProperties();
+            const int64_t difference = int64_t (maximum) - int64_t (props.latencyNumSamples);
+            if (difference < 0 || difference > std::numeric_limits<int>::max())
+                throw std::invalid_argument ("Summing compensation delay overflow");
+            const auto delay = int (difference);
+            const bool audio = props.hasAudio && props.numberOfChannels > 0;
+            auto* existing = dynamic_cast<LatencyNode*> (node);
+            if (audio && (props.nodeID == 0 || consumerID == 0))
+                continue; // Return/Send transforms may still discover inputs; prepare must reject if unresolved.
+            LatencyNode::RetainedAudioEdge request { {uint64_t (props.nodeID), uint64_t (consumerID), uint32_t (port)},
+                                                     maximumDelay, this, props.hasMidi };
+            if (existing && existing->isCompensationFor (this))
+            {
+                if (existing->usesHistory() != audio)
+                    throw std::invalid_argument ("Audio/MIDI compensation edge shape changed during transform");
+                if (audio) existing->updateRetainedRequest (delay, request);
+                else existing->updateLegacyCompensation (delay, request);
+                continue;
+            }
+            if (!audio && delay == 0)
+                continue; // Preserve formerly undelayed MIDI edges; no new delay queue.
+            if (audio && uint32_t (delay) > maximumDelay)
+                throw std::length_error ("Summing requested audio compensation exceeds prepared history capacity");
+            size_t ownedIndex = ownedNodes.size();
+            for (size_t i = 0; i < ownedNodes.size(); ++i)
+                if (ownedNodes[i].get() == node) { ownedIndex = i; break; }
+            std::unique_ptr<LatencyNode> tap;
+            if (ownedIndex != ownedNodes.size())
+            {
+                auto owned = std::move (ownedNodes[ownedIndex]);
+                tap = audio ? std::make_unique<LatencyNode> (std::move (owned), delay, request)
+                            : std::make_unique<LatencyNode> (std::move (owned), delay);
+            }
+            else
+                tap = audio ? std::make_unique<LatencyNode> (node, delay, request)
